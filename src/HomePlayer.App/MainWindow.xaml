<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HomePlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HomePlayer">
    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="TitleNavButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TitleIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid x:Name="AppTitleBar" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionPad" Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="BarLibraryButton"
                    Style="{StaticResource TitleNavButtonStyle}"
                    Height="40"
                    AutomationProperties.Name="媒体库"
                    ToolTipService.ToolTip="媒体库"
                    Click="TitleLibrary_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="媒体库" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BarPlayerButton"
                    Style="{StaticResource TitleNavButtonStyle}"
                    Height="40"
                    AutomationProperties.Name="正在播放"
                    ToolTipService.ToolTip="正在播放"
                    Click="TitlePlayer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="正在播放" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid
                x:Name="LibraryDrag"
                Grid.Column="1"
                Background="Transparent">
                <TextBlock
                    Text="HomePlayer"
                    Margin="8,0,12,0"
                    VerticalAlignment="Center" />
            </Grid>
            <Button
                x:Name="BarSettingsButton"
                Grid.Column="2"
                Style="{StaticResource TitleIconButtonStyle}"
                Height="40"
                Width="46"
                AutomationProperties.Name="设置"
                ToolTipService.ToolTip="设置"
                Click="TitleSettings_Click">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="媒体库" Tag="library" Icon="Folder" />
                <NavigationViewItem Content="正在播放" Tag="player" Icon="Play" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="RootFrame" />
        </NavigationView>
        <Grid
            x:Name="OverlayTitleBar"
            Grid.Row="0"
            Grid.RowSpan="2"
            Height="40"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Canvas.ZIndex="1000"
            RequestedTheme="Dark"
            Background="#CC1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="TitleLibraryButton"
                    MinWidth="0"
                    Height="40"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Foreground="White"
                    AutomationProperties.Name="媒体库"
                    ToolTipService.ToolTip="媒体库"
                    Click="TitleLibrary_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="媒体库" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="TitlePlayerButton"
                    MinWidth="0"
                    Height="40"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Foreground="White"
                    AutomationProperties.Name="正在播放"
                    ToolTipService.ToolTip="正在播放"
                    Click="TitlePlayer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="正在播放" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid
                x:Name="OverlayDrag"
                Grid.Column="1"
                Background="Transparent"
                PointerPressed="OverlayDrag_Pressed">
                <TextBlock
                    Text="HomePlayer"
                    Margin="8,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="White" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    x:Name="TitleSettingsButton"
                    Style="{StaticResource CaptionButtonStyle}"
                    AutomationProperties.Name="设置"
                    ToolTipService.ToolTip="设置"
                    Click="TitleSettings_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button
                    x:Name="MinimizeButton"
                    AutomationProperties.Name="最小化"
                    ToolTipService.ToolTip="最小化"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="Minimize_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="12" />
                </Button>
                <Button
                    x:Name="MaximizeButton"
                    AutomationProperties.Name="最大化"
                    ToolTipService.ToolTip="最大化"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="Maximize_Click">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="12" />
                </Button>
                <Button
                    x:Name="CloseButton"
                    AutomationProperties.Name="关闭"
                    ToolTipService.ToolTip="关闭"
                    Style="{StaticResource CaptionCloseButtonStyle}"
                    Click="Close_Click">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
