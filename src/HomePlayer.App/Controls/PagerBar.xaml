<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HomePlayer.PagerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="0,4" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            x:Name="TotalText"
            Margin="4,0,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
            <Button x:Name="FirstButton" Style="{StaticResource PagerButtonStyle}" Content="«" ToolTipService.ToolTip="首页" Click="First_Click" />
            <Button x:Name="PreviousButton" Style="{StaticResource PagerButtonStyle}" Content="‹" ToolTipService.ToolTip="上一页" Click="Previous_Click" />
            <StackPanel x:Name="PageItems" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
            <Button x:Name="NextButton" Style="{StaticResource PagerButtonStyle}" Content="›" ToolTipService.ToolTip="下一页" Click="Next_Click" />
            <Button x:Name="LastButton" Style="{StaticResource PagerButtonStyle}" Content="»" ToolTipService.ToolTip="末页" Click="Last_Click" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="每页" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="PageSizeBox" MinWidth="68" Height="30" FontSize="12" SelectionChanged="PageSize_SelectionChanged" />
            <TextBlock Text="跳至" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox
                x:Name="JumpBox"
                Width="52"
                Height="30"
                Padding="6,4"
                FontSize="12"
                TextAlignment="Center"
                KeyDown="Jump_KeyDown"
                LostFocus="Jump_LostFocus" />
            <TextBlock Text="页" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
