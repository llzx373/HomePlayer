<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HomePlayer.PagerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="0,4" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                x:Name="FirstButton"
                Content="«"
                MinWidth="32"
                Height="28"
                Padding="6,0"
                ToolTipService.ToolTip="首页"
                Click="First_Click" />
            <Button
                x:Name="PreviousButton"
                Content="‹"
                MinWidth="32"
                Height="28"
                Padding="6,0"
                ToolTipService.ToolTip="上一页"
                Click="Previous_Click" />
            <Button
                x:Name="NextButton"
                Content="›"
                MinWidth="32"
                Height="28"
                Padding="6,0"
                ToolTipService.ToolTip="下一页"
                Click="Next_Click" />
            <Button
                x:Name="LastButton"
                Content="»"
                MinWidth="32"
                Height="28"
                Padding="6,0"
                ToolTipService.ToolTip="末页"
                Click="Last_Click" />
        </StackPanel>
        <StackPanel
            x:Name="PageItems"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="2"
            VerticalAlignment="Center" />
        <TextBlock
            x:Name="TotalText"
            Grid.Column="2"
            Margin="4,0,0,0"
            VerticalAlignment="Center"
            Opacity="0.7" />
        <StackPanel
            Grid.Column="3"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">
            <TextBlock Text="每页" VerticalAlignment="Center" Opacity="0.7" />
            <ComboBox
                x:Name="PageSizeBox"
                MinWidth="72"
                Height="28"
                SelectionChanged="PageSize_SelectionChanged" />
            <TextBlock Text="跳至" VerticalAlignment="Center" Opacity="0.7" />
            <TextBox
                x:Name="JumpBox"
                Width="56"
                Height="28"
                Padding="6,4"
                KeyDown="Jump_KeyDown"
                LostFocus="Jump_LostFocus" />
            <TextBlock Text="页" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Grid>
</UserControl>
