<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HomePlayer"
    SizeChanged="LibraryPage_SizeChanged">
    <Page.Resources>
        <Style x:Key="MediaBadgeBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#B3000000" />
        </Style>
        <Style x:Key="MediaBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>
    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="媒体库" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView x:Name="LibraryList" Grid.Row="1" SelectionChanged="LibraryList_SelectionChanged" />
            <ToggleSwitch
                x:Name="RecursiveSwitch"
                Grid.Row="2"
                IsOn="True"
                OnContent="递归包含子文件夹"
                OffContent="仅当前文件夹"
                Toggled="Recursive_Toggled" />
            <TreeView
                x:Name="FolderTree"
                Grid.Row="3"
                SelectionChanged="FolderTree_SelectionChanged"
                Expanding="FolderTree_Expanding"
                Collapsed="FolderTree_Collapsed"
                RightTapped="FolderTree_RightTapped">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="27"
                                CornerRadius="3"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Image Source="{Binding Content.Cover}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Content.Name}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Content.CountText}"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <StackPanel Grid.Row="4" Spacing="8">
                <Button Content="添加库" Click="Add_Click" HorizontalAlignment="Stretch" />
                <Button Content="移除所选库" Click="Remove_Click" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RadioButtons x:Name="BrowseTabs" SelectedIndex="0" SelectionChanged="BrowseTabs_SelectionChanged">
                <RadioButtons.Items>
                    <x:String>媒体库</x:String>
                    <x:String>继续观看</x:String>
                    <x:String>最近添加</x:String>
                    <x:String>最近播放</x:String>
                </RadioButtons.Items>
            </RadioButtons>
            <Grid x:Name="LibraryToolbar" Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="按名称过滤" TextChanged="Search_TextChanged" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Filter_SelectionChanged" />
                <ComboBox x:Name="SortBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="Sort_SelectionChanged" />
                <Button x:Name="RandomButton" Grid.Column="3" Content="随机播放" Click="Random_Click" />
                <Button x:Name="RefreshButton" Grid.Column="4" Content="刷新" Click="Refresh_Click" />
            </Grid>
            <InfoBar
                x:Name="UpdateBar"
                Grid.Row="2"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False"
                Title="媒体库有更新">
                <InfoBar.ActionButton>
                    <Button Content="刷新" Click="RefreshPending_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="ScanWarningBar"
                Grid.Row="3"
                Severity="Warning"
                IsOpen="False"
                IsClosable="False"
                Title="扫描不完整" />
            <InfoBar
                x:Name="LibraryErrorBar"
                Grid.Row="4"
                Severity="Error"
                IsOpen="False"
                IsClosable="False"
                Title="媒体库读取失败">
                <InfoBar.ActionButton>
                    <Button Content="重试" Click="RetryLoad_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid Grid.Row="5">
                <TextBlock x:Name="EmptyText" Text="还没有媒体库。添加一个本地文件夹开始。" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ProgressRing
                    x:Name="LoadingIndicator"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Canvas.ZIndex="1" />
                <TextBlock
                    x:Name="ScanProgressText"
                    Margin="0,56,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed"
                    Canvas.ZIndex="1" />
                <GridView
                    x:Name="Cards"
                    DoubleTapped="Cards_DoubleTapped"
                    RightTapped="Cards_RightTapped"
                    KeyDown="Cards_KeyDown"
                    IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" RowSpacing="6" DoubleTapped="Card_DoubleTapped">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                    <Grid>
                                        <FontIcon Glyph="&#xE714;" FontSize="32" Opacity="0.25" />
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                        <Border
                                            Style="{StaticResource MediaBadgeBorderStyle}"
                                            Background="{Binding BadgeBackground}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource MediaBadgeTextStyle}" />
                                        </Border>
                                        <Border
                                            Style="{StaticResource MediaBadgeBorderStyle}"
                                            Background="#CC1B5E20"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding WatchedVisibility}">
                                            <TextBlock Text="已看" Style="{StaticResource MediaBadgeTextStyle}" />
                                        </Border>
                                        <ProgressBar
                                            Value="{Binding Progress}"
                                            Maximum="1"
                                            Height="3"
                                            VerticalAlignment="Bottom"
                                            Padding="0"
                                            BorderThickness="0"
                                            Visibility="{Binding ProgressVisibility}" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
            <local:PagerBar x:Name="Pager" Grid.Row="6" />
        </Grid>
    </Grid>
</Page>
