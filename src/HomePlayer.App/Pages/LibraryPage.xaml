<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="媒体库" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView x:Name="LibraryList" Grid.Row="1" SelectionChanged="LibraryList_SelectionChanged" />
            <StackPanel Grid.Row="2" Spacing="8">
                <Button Content="添加库" Click="Add_Click" HorizontalAlignment="Stretch" />
                <Button Content="移除所选库" Click="Remove_Click" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="按名称过滤" TextChanged="Filter_Changed" />
                <ComboBox x:Name="SortBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                <Button Grid.Column="2" Content="刷新" Click="Refresh_Click" />
            </Grid>
            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptyText" Text="还没有媒体库。添加一个本地文件夹开始。" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <GridView
                    x:Name="Cards"
                    DoubleTapped="Cards_DoubleTapped"
                    RightTapped="Cards_RightTapped"
                    IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" RowSpacing="6" DoubleTapped="Card_DoubleTapped">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Badge}" Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Opacity="0.7" TextWrapping="Wrap" MaxLines="2" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>
