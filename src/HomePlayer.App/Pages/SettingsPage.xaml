<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
        <TabView
            x:Name="SettingsTabs"
            Grid.Row="1"
            Margin="0,16,0,0"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False"
            AllowDropTabs="False">
            <TabView.TabItems>
                <TabViewItem Header="常规" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="0,16,0,0">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="常规" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBox x:Name="ApiKeyBox" Header="TMDB API Key" PlaceholderText="只保存在本机，输入停顿后自动保存" />
                                    <TextBlock x:Name="SaveStatusText" Style="{StaticResource SettingsDescriptionStyle}" Text="更改会自动保存。" />
                                    <ToggleSwitch
                                        x:Name="TraySwitch"
                                        Header="点击关闭时"
                                        OnContent="最小化到系统托盘"
                                        OffContent="退出程序"
                                        Toggled="Tray_Toggled" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="托盘图标左键打开窗口，右键可以真正退出。" />
                                    <ToggleSwitch
                                        x:Name="HistorySwitch"
                                        Header="播放历史与续播"
                                        OnContent="记录最近播放和观看进度"
                                        OffContent="不再记录新的播放历史"
                                        Toggled="History_Toggled" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="关闭后保留已有记录，但不再更新续播位置和最近播放。" />
                                    <Button Content="清空播放历史" Click="ClearHistory_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="文件关联" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="安装程序会登记支持的视频类型；默认播放器仍需在 Windows 设置中确认。" />
                                    <Button Content="打开系统默认应用设置" Click="DefaultApps_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="更新" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <ComboBox x:Name="UpdateChannelBox" Header="更新通道" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="稳定版" Tag="stable" />
                                        <ComboBoxItem Content="测试版" Tag="beta" />
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                                        <Button x:Name="UpdateDownloadButton" Content="打开发布页" Click="OpenUpdate_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="播放" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="0,16,0,0">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="窗口与播放" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <ComboBox x:Name="TitleBarBox" Header="窗口外观" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="经典标题栏" />
                                        <ComboBoxItem Content="无边框播放" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="无边框播放只作用于正在播放页；鼠标移向顶部或底部时显示对应控件。" />
                                    <ToggleSwitch x:Name="FitWindowSwitch" Header="自适应窗口" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="换片时按原始画面比例调整窗口；全屏时不改变窗口大小。" />
                                    <ToggleSwitch x:Name="AlwaysOnTopSwitch" Header="窗口置顶" />
                                    <ToggleSwitch x:Name="AutoPlayNextSwitch" Header="播完自动连播" OnContent="自动播放下一条" OffContent="播完停止" Toggled="AutoPlayNext_Toggled" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="从剧集与合集入口播放时，会按季集顺序自动连播。" />
                                    <ToggleSwitch x:Name="HardwareAccelerationSwitch" Header="硬件加速（D3D11）" OnContent="降低稳态 CPU，失败时自动降级" OffContent="使用软件解码" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="硬解可减少稳态 CPU，但部分设备的随机 seek 会更慢；关闭后从下一次播放开始使用软件路线。" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="会话与导航" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <ToggleSwitch x:Name="RestorePlaylistSwitch" Header="启动时恢复上次播放列表" OnContent="恢复队列但不自动播放" OffContent="启动时空队列" />
                                    <NumberBox x:Name="ResumeRewindBox" Header="续播倒退秒数" Minimum="0" Maximum="10" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="SeekStepBox" Header="小步快进快退秒数" Minimum="1" Maximum="120" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Name="LargeSeekStepBox" Header="大步快进快退秒数" Minimum="5" Maximum="600" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                    <ToggleSwitch x:Name="RememberVolumeSwitch" Header="按文件记住音量" />
                                    <ToggleSwitch x:Name="RememberRateSwitch" Header="按文件记住倍速（默认关闭）" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="声音" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <ComboBox x:Name="AudioDeviceBox" Header="播放设备" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="AudioDevice_Changed" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="默认跟随 Windows 当前的声音出口，改完后从下一次播放开始生效。" />
                                    <TextBox x:Name="PreferredAudioLanguageBox" Header="首选音轨语言" PlaceholderText="例如 ja、en、zh；留空为自动" />
                                    <ToggleSwitch x:Name="AudioNormalizationSwitch" Header="音量归一化" />
                                    <ToggleSwitch x:Name="AudioNightModeSwitch" Header="夜间模式（压缩动态范围）" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="字幕外观" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <NumberBox
                                        x:Name="SubtitleFontSizeBox"
                                        Header="基准字号"
                                        Minimum="16"
                                        Maximum="64"
                                        SmallChange="2"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="SubtitleFontSize_Changed" />
                                    <ComboBox x:Name="SubtitleColorBox" Header="文字颜色" HorizontalAlignment="Stretch" SelectionChanged="SubtitleStyle_Changed">
                                        <ComboBoxItem Content="白色" />
                                        <ComboBoxItem Content="黄色" />
                                        <ComboBoxItem Content="浅绿色" />
                                    </ComboBox>
                                    <ComboBox x:Name="SubtitlePositionBox" Header="显示位置" HorizontalAlignment="Stretch" SelectionChanged="SubtitleStyle_Changed">
                                        <ComboBoxItem Content="顶部" />
                                        <ComboBoxItem Content="居中" />
                                        <ComboBoxItem Content="底部" />
                                    </ComboBox>
                                    <Slider
                                        x:Name="SubtitleOpacitySlider"
                                        Header="背景不透明度"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="5"
                                        ValueChanged="SubtitleOpacity_Changed" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="字号会随播放窗口高度缩放；样式修改立即应用于当前字幕。" />
                                    <ToggleSwitch x:Name="SnapshotSubtitlesSwitch" Header="截图包含当前字幕" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="快捷键" IsClosable="False">
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="12">
                                <TextBlock Text="快捷键" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="点一项后面的按钮再按下新快捷键。同一组键只能分配给一个功能。" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,12" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HotkeyList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8" Padding="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="168" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{Binding Display}" Click="Hotkey_Click" HorizontalAlignment="Stretch" />
                                                <Button Grid.Column="2" Content="清除" Click="HotkeyClear_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="恢复默认快捷键" Click="ResetHotkeys_Click" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </TabViewItem>

                <TabViewItem Header="编解码器" IsClosable="False">
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="12">
                                <TextBlock Text="编解码器" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="CodecSummary" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="按从上到下的顺序尝试。先选中一行再调整顺序；不可用的 x86 滤镜会列出但不能勾选。改完后从下一次播放开始生效。" />
                            </StackPanel>
                            <TabView
                                Grid.Row="1"
                                Margin="0,12"
                                IsAddTabButtonVisible="False"
                                CanDragTabs="False"
                                CanReorderTabs="False"
                                AllowDropTabs="False">
                                <TabView.Resources>
                                    <Style TargetType="TabViewItem">
                                        <Setter Property="IsClosable" Value="False" />
                                    </Style>
                                </TabView.Resources>
                                <TabViewItem Header="分离器">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ListView x:Name="SplitterList" SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding Usable}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" />
                                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                                            <Button Content="上移" Click="SplitterUp_Click" />
                                            <Button Content="下移" Click="SplitterDown_Click" />
                                        </StackPanel>
                                    </Grid>
                                </TabViewItem>
                                <TabViewItem Header="视频解码">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ListView x:Name="VideoList" SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding Usable}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" />
                                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                                            <Button Content="上移" Click="VideoUp_Click" />
                                            <Button Content="下移" Click="VideoDown_Click" />
                                        </StackPanel>
                                    </Grid>
                                </TabViewItem>
                                <TabViewItem Header="音频解码">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ListView x:Name="AudioList" SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding Usable}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" />
                                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                                            <Button Content="上移" Click="AudioUp_Click" />
                                            <Button Content="下移" Click="AudioDown_Click" />
                                        </StackPanel>
                                    </Grid>
                                </TabViewItem>
                            </TabView>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,0,12,0" VerticalAlignment="Center" Text="分离器和解码都失败时会改用自带 FFmpeg；缩略图始终由 FFmpeg 抽取。" />
                                <Button Grid.Column="1" Content="恢复默认顺序" Click="ResetCodecs_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </TabViewItem>

                <TabViewItem Header="存储与诊断" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="存储与诊断" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="数据备份" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="备份包包含媒体库、观看进度、播放偏好和设置；其中也会包含本机 TMDB API Key。每次启动还会自动保留最近两代备份。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导出备份" Click="ExportBackup_Click" />
                                    <Button Content="导入备份" Click="ImportBackup_Click" />
                                    <Button Content="打开备份文件夹" Click="OpenBackups_Click" />
                                </StackPanel>
                                <TextBlock x:Name="BackupStatusText" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CacheText" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="清除缓存只重建缩略图和海报，不会删除视频或观看进度。" />
                                <Button Content="清除缩略图缓存" Click="Clear_Click" HorizontalAlignment="Left" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="清理没有关联媒体的数据库行，以及本地磁盘上已不存在的库外历史记录；当前媒体库和离线路径会保留。" TextWrapping="Wrap" />
                                <Button Content="清理孤立记录" Click="CleanupOrphans_Click" HorizontalAlignment="Left" />
                                <TextBlock Text="崩溃日志" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="CrashSummary" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="未处理异常、后台任务异常、原生崩溃和异常退出都会记录到本机数据目录。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="查看崩溃日志" Click="ViewCrashes_Click" />
                                    <Button Content="打开日志文件夹" Click="OpenCrashes_Click" />
                                    <Button Content="清除崩溃日志" Click="ClearCrashes_Click" />
                                </StackPanel>
                                <TextBlock Text="诊断包" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="默认包含版本、系统、播放管线和脱敏后的最近错误，不包含完整媒体路径或 API Key。" TextWrapping="Wrap" />
                                <CheckBox x:Name="DiagnosticSensitiveCheck" Content="包含完整日志和设置（可能包含媒体路径与 API Key）" />
                                <Button Content="导出诊断包" Click="ExportDiagnostics_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
