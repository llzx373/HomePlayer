<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.AiSubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="AI 自动字幕" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="MediaText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" Header="本地 AI 字幕" OnContent="已启用" OffContent="已停用" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ContentControl x:Name="ConfigurationPanel">
                <StackPanel Spacing="12">
                    <TextBlock Text="完全在本地识别和翻译。仅下载模型时需要网络；原始媒体、已有字幕和译文不会上传。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="SourceBox" Header="来源（已有文本字幕时默认直接翻译）" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" SelectionChanged="Source_Changed" />
                        <ComboBox x:Name="SourceLanguageBox" Grid.Column="1" Header="源语言" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="TargetLanguageBox" Grid.Column="2" Header="目标语言" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="RecognitionModelBox" Grid.Row="1" Header="识别模型" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" />
                        <ComboBox x:Name="AudioTrackBox" Grid.Row="1" Grid.Column="1" Header="识别音轨" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" />
                        <ComboBox x:Name="TranslationModelBox" Grid.Row="1" Grid.Column="2" Header="翻译模型" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" />
                        <TextBox x:Name="MirrorBox" Grid.Row="2" Header="模型下载镜像" HorizontalAlignment="Stretch" />
                        <CheckBox x:Name="BilingualCheck" Grid.Row="2" Grid.Column="1" Content="保留原文，生成双语字幕" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        <ToggleSwitch x:Name="TranslateAfterSwitch" Grid.Row="2" Grid.Column="2" Header="识别后继续翻译" OnContent="是" OffContent="否" VerticalAlignment="Bottom" Toggled="TranslateAfter_Toggled" />
                        <ComboBox x:Name="DeviceBox" Grid.Row="3" Header="计算设备" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" />
                    <TextBox x:Name="ProxyBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Header="下载代理（留空则直连）" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="EngineBox" Grid.Row="4" Header="识别引擎" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" SelectionChanged="Engine_Changed" />
                    <ToggleSwitch x:Name="LiveSwitch" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Header="打开视频后自动生成实时字幕（英/日/韩）" OnContent="开启" OffContent="关闭" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </ContentControl>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Content="开始生成" Click="Start_Click" Style="{ThemeResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消任务" Click="Cancel_Click" IsEnabled="False" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="保存修改" Click="Save_Click" IsEnabled="False" />
            <Button x:Name="ExportButton" Grid.Column="3" Content="导出" Click="Export_Click" IsEnabled="False" />
            <Button x:Name="UseButton" Grid.Column="4" Content="在当前影片中使用" Click="Use_Click" HorizontalAlignment="Right" IsEnabled="False" />
        </Grid>
        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="1000" Height="6" />
            <TextBlock x:Name="StatusText" Text="选择来源后开始。模型较大，请留意下载大小和剩余磁盘空间。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Row="4" Margin="0,4,0,0" Padding="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="EmptyResultText" Text="生成后可在这里逐条校对文本；时间轴保持不变。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <ListView x:Name="CueList" Visibility="Collapsed" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="4" MinHeight="54">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="164" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeRange}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
