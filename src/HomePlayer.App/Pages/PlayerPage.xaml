<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ControlsRow" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Stage">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="VideoHost" Background="Black" DoubleTapped="VideoHost_DoubleTapped">
                <SwapChainPanel x:Name="VideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DoubleTapped="VideoHost_DoubleTapped" />
                <Grid x:Name="SubtitleLayer" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border
                        x:Name="SubtitlePill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,48"
                        Padding="18,8"
                        CornerRadius="8"
                        MaxWidth="640"
                        Background="#99000000">
                        <TextBlock
                            x:Name="SubtitleText"
                            FontFamily="Segoe UI"
                            FontSize="28"
                            Foreground="White"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
                <Border
                    x:Name="PipelinePanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="360"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed"
                    Padding="12">
                    <ScrollViewer>
                        <TextBlock x:Name="PipelineText" FontFamily="Consolas" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid
                x:Name="PlaylistPane"
                Grid.Column="1"
                Width="300"
                Padding="12"
                RowSpacing="8"
                Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="播放列表" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="收起" HorizontalAlignment="Right" Click="CollapsePlaylist_Click" />
                </Grid>
                <ListView
                    x:Name="PlaylistView"
                    Grid.Row="1"
                    CanReorderItems="True"
                    CanDragItems="True"
                    AllowDrop="True"
                    DoubleTapped="Playlist_DoubleTapped"
                    DragItemsCompleted="Playlist_Reordered">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Error}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="8">
                    <ComboBox x:Name="RepeatBox" HorizontalAlignment="Stretch" SelectionChanged="Repeat_Changed">
                        <ComboBoxItem Content="播完停止" />
                        <ComboBoxItem Content="循环单条" />
                        <ComboBoxItem Content="循环全部" />
                    </ComboBox>
                    <ToggleSwitch x:Name="ShuffleSwitch" Header="随机" Toggled="Shuffle_Toggled" />
                    <Button Content="清空" Click="Clear_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        <Grid
            x:Name="ControlsBar"
            Grid.Row="1"
            Padding="12,8,12,12"
            RowSpacing="4"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CurrentTimeText"
                    MinWidth="64"
                    Margin="0,0,10,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextAlignment="Right"
                    Text="00:00" />
                <Grid
                    x:Name="PositionBar"
                    Grid.Column="1"
                    Height="22"
                    Background="Transparent"
                    PointerPressed="Position_Pressed"
                    PointerMoved="Position_Moved"
                    PointerReleased="Position_Released"
                    PointerCanceled="Position_Released"
                    PointerCaptureLost="Position_Released">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlayedColumn" Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="2"
                        Height="4"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Background="#667F7F7F" />
                    <Border
                        Grid.Column="0"
                        Height="4"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Border
                        x:Name="PositionThumb"
                        Grid.ColumnSpan="2"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="7"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <TextBlock
                    x:Name="DurationTimeText"
                    Grid.Column="2"
                    MinWidth="64"
                    Margin="10,0,0,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextAlignment="Left"
                    Text="00:00" />
            </Grid>
            <Grid x:Name="ButtonsRow" Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    HorizontalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <Button
                                x:Name="OpenButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="打开"
                                ToolTipService.ToolTip="打开"
                                Click="Open_Click">
                                <FontIcon x:Name="OpenIcon" Glyph="&#xE8E5;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="OpenMenuButton"
                                Width="20"
                                Height="36"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="打开选项">
                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="OpenFlyout" Placement="Bottom" Opening="OpenFlyout_Opening">
                                        <MenuFlyoutItem
                                            x:Name="OpenFilesItem"
                                            Text="打开文件"
                                            Click="Open_Click" />
                                        <MenuFlyoutItem
                                            x:Name="FfmpegItem"
                                            Text="用 FFmpeg 打开当前项"
                                            Click="Ffmpeg_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                x:Name="StopButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="停止"
                                ToolTipService.ToolTip="停止"
                                Click="Stop_Click">
                                <FontIcon x:Name="StopIcon" Glyph="&#xE71A;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="PreviousButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="上一个"
                                ToolTipService.ToolTip="上一个"
                                Click="Previous_Click">
                                <FontIcon x:Name="PreviousIcon" Glyph="&#xE892;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="SeekBackButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="后退 5 秒"
                                ToolTipService.ToolTip="后退 5 秒"
                                Click="SeekBack_Click">
                                <FontIcon x:Name="SeekBackIcon" Glyph="&#xED3C;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="PlayButton"
                                Style="{StaticResource PlayerPlayButton}"
                                AutomationProperties.Name="播放/暂停"
                                ToolTipService.ToolTip="播放/暂停"
                                Click="Play_Click">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18" />
                            </Button>
                            <Button
                                x:Name="SeekForwardButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="前进 5 秒"
                                ToolTipService.ToolTip="前进 5 秒"
                                Click="SeekForward_Click">
                                <FontIcon x:Name="SeekForwardIcon" Glyph="&#xED3D;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="NextButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="下一个"
                                ToolTipService.ToolTip="下一个"
                                Click="Next_Click">
                                <FontIcon x:Name="NextIcon" Glyph="&#xE893;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="StepFrameButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="下一帧"
                                ToolTipService.ToolTip="下一帧"
                                IsEnabled="False"
                                Click="StepFrame_Click">
                                <FontIcon x:Name="StepFrameIcon" Glyph="&#xE1A5;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="MuteButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="静音"
                            ToolTipService.ToolTip="静音"
                            Click="Mute_Click">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE995;" FontSize="16" />
                        </ToggleButton>
                        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Volume_Changed" />
                    </StackPanel>
                    <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                    <Button
                        x:Name="SpeedButton"
                        Style="{StaticResource PlayerSpeedButton}"
                        AutomationProperties.Name="倍速"
                        ToolTipService.ToolTip="倍速">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="SpeedIcon" Glyph="&#xEC57;" FontSize="16" />
                            <TextBlock x:Name="SpeedText" Text="1.0×" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="SpeedFlyout" Placement="Bottom" Opening="SpeedFlyout_Opening">
                                <RadioMenuFlyoutItem
                                    x:Name="Speed05Item"
                                    Text="0.5×"
                                    GroupName="Speed"
                                    Tag="0.5"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed075Item"
                                    Text="0.75×"
                                    GroupName="Speed"
                                    Tag="0.75"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed10Item"
                                    Text="1.0×"
                                    GroupName="Speed"
                                    Tag="1.0"
                                    IsChecked="True"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed125Item"
                                    Text="1.25×"
                                    GroupName="Speed"
                                    Tag="1.25"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed15Item"
                                    Text="1.5×"
                                    GroupName="Speed"
                                    Tag="1.5"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed20Item"
                                    Text="2.0×"
                                    GroupName="Speed"
                                    Tag="2.0"
                                    Click="SpeedItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="AudioButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="音轨"
                        ToolTipService.ToolTip="音轨"
                        IsEnabled="False">
                        <FontIcon x:Name="AudioIcon" Glyph="&#xE8D6;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="AudioFlyout" Placement="Bottom" Opening="AudioFlyout_Opening" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="SubtitleButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="字幕"
                        ToolTipService.ToolTip="字幕">
                        <FontIcon x:Name="SubtitleIcon" Glyph="&#xED1E;" FontSize="16" Opacity="0.45" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SubtitleFlyout" Placement="Bottom" Opening="SubtitleFlyout_Opening" />
                        </Button.Flyout>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button
                            x:Name="RepeatButton"
                            Style="{StaticResource PlayerIconButton}"
                            AutomationProperties.Name="循环"
                            ToolTipService.ToolTip="循环"
                            Click="Repeat_Click">
                            <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16" Opacity="0.45" />
                        </Button>
                        <ToggleButton
                            x:Name="ShuffleButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="随机"
                            ToolTipService.ToolTip="随机"
                            Click="Shuffle_Click">
                            <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="16" Opacity="0.45" />
                        </ToggleButton>
                    </StackPanel>
                    <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button
                            x:Name="SnapshotButton"
                            Style="{StaticResource PlayerIconButton}"
                            AutomationProperties.Name="截图"
                            ToolTipService.ToolTip="截图"
                            IsEnabled="False"
                            Click="Snapshot_Click">
                            <FontIcon x:Name="SnapshotIcon" Glyph="&#xE722;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="AspectButton"
                            Style="{StaticResource PlayerIconButton}"
                            AutomationProperties.Name="画面比例"
                            ToolTipService.ToolTip="画面比例">
                            <FontIcon x:Name="AspectIcon" Glyph="&#xE7F4;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="AspectFlyout" Placement="Bottom" Opening="AspectFlyout_Opening">
                                    <RadioMenuFlyoutItem
                                        x:Name="AspectFitItem"
                                        Text="适应"
                                        GroupName="Aspect"
                                        Tag="Fit"
                                        IsChecked="True"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="AspectFillItem"
                                        Text="填充"
                                        GroupName="Aspect"
                                        Tag="Fill"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="AspectStretchItem"
                                        Text="拉伸"
                                        GroupName="Aspect"
                                        Tag="Stretch"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="Aspect16x9Item"
                                        Text="16:9"
                                        GroupName="Aspect"
                                        Tag="Ratio16x9"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="Aspect4x3Item"
                                        Text="4:3"
                                        GroupName="Aspect"
                                        Tag="Ratio4x3"
                                        Click="AspectItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ToggleButton
                            x:Name="FitWindowButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="自适应窗口"
                            ToolTipService.ToolTip="自适应窗口"
                            Click="FitWindow_Click">
                            <FontIcon x:Name="FitWindowIcon" Glyph="&#xE7C4;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="AlwaysOnTopButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="置顶"
                            ToolTipService.ToolTip="置顶"
                            Click="AlwaysOnTop_Click">
                            <FontIcon x:Name="AlwaysOnTopIcon" Glyph="&#xE840;" FontSize="16" Opacity="0.45" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="PlaylistButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="播放列表"
                            ToolTipService.ToolTip="播放列表"
                            Click="PlaylistButton_Click">
                            <FontIcon x:Name="PlaylistIcon" Glyph="&#xE90A;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="PipelineButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="管线信息"
                            ToolTipService.ToolTip="管线信息"
                            Click="Pipeline_Click">
                            <FontIcon x:Name="PipelineIcon" Glyph="&#xE946;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                    <Button
                        x:Name="FullscreenButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="全屏"
                        ToolTipService.ToolTip="全屏"
                        Click="Fullscreen_Click">
                        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Opacity="0.75" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
