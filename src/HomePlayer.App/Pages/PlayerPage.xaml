<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="Accel_Play" />
        <KeyboardAccelerator Key="Left" Invoked="Accel_Back" />
        <KeyboardAccelerator Key="Right" Invoked="Accel_Forward" />
        <KeyboardAccelerator Key="Up" Invoked="Accel_VolumeUp" />
        <KeyboardAccelerator Key="Down" Invoked="Accel_VolumeDown" />
        <KeyboardAccelerator Key="F" Invoked="Accel_Fullscreen" />
        <KeyboardAccelerator Key="Escape" Invoked="Accel_Escape" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="Accel_Pipeline" />
    </Page.KeyboardAccelerators>
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Stage">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="VideoHost" Background="Black">
                <SwapChainPanel x:Name="VideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Border
                    x:Name="PipelinePanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="360"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed"
                    Padding="12">
                    <ScrollViewer>
                        <TextBlock x:Name="PipelineText" FontFamily="Consolas" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid x:Name="PlaylistPane" Grid.Column="1" Width="300" Margin="12,0,0,0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="播放列表" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="收起" HorizontalAlignment="Right" Click="CollapsePlaylist_Click" />
                </Grid>
                <ListView
                    x:Name="PlaylistView"
                    Grid.Row="1"
                    CanReorderItems="True"
                    CanDragItems="True"
                    AllowDrop="True"
                    DoubleTapped="Playlist_DoubleTapped"
                    DragItemsCompleted="Playlist_Reordered">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Error}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="8">
                    <ComboBox x:Name="RepeatBox" HorizontalAlignment="Stretch" SelectionChanged="Repeat_Changed">
                        <ComboBoxItem Content="播完停止" />
                        <ComboBoxItem Content="循环单条" />
                        <ComboBoxItem Content="循环全部" />
                    </ComboBox>
                    <ToggleSwitch x:Name="ShuffleSwitch" Header="随机" Toggled="Shuffle_Toggled" />
                    <Button Content="清空" Click="Clear_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    HorizontalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开" Click="Open_Click" />
                        <Button Content="上一首" Click="Previous_Click" />
                        <Button x:Name="PlayButton" Content="播放" Click="Play_Click" />
                        <Button Content="下一首" Click="Next_Click" />
                        <Button Content="停止" Click="Stop_Click" />
                        <TextBlock x:Name="TimeText" VerticalAlignment="Center" />
                        <Button Content="管线信息" Click="Pipeline_Click" />
                        <Button Content="用 FFmpeg 打开" Click="Ffmpeg_Click" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" ValueChanged="Volume_Changed" />
                    <ToggleButton x:Name="MuteButton" Content="静音" Click="Mute_Click" />
                    <ToggleButton x:Name="PlaylistButton" Content="播放列表" IsChecked="True" Click="PlaylistButton_Click" />
                    <Button x:Name="FullscreenButton" Content="全屏" Click="Fullscreen_Click" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Opacity="0.75" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
