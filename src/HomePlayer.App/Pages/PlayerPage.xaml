<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HomePlayer.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ControlsRow" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Stage">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="VideoHost" Background="Black" DoubleTapped="VideoHost_DoubleTapped">
                <SwapChainPanel x:Name="VideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DoubleTapped="VideoHost_DoubleTapped" />
                <Grid x:Name="SubtitleLayer" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border
                        x:Name="SubtitlePill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,48"
                        Padding="18,8"
                        CornerRadius="8"
                        MaxWidth="640"
                        Background="#99000000">
                        <TextBlock
                            x:Name="SubtitleText"
                            FontFamily="Segoe UI"
                            FontSize="28"
                            Foreground="White"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
                <Border
                    x:Name="PipelinePanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="360"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="Collapsed"
                    Padding="12">
                    <ScrollViewer>
                        <TextBlock x:Name="PipelineText" FontFamily="Consolas" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border
                x:Name="PlaylistPane"
                Grid.Column="1"
                Width="300"
                Visibility="Collapsed"
                RequestedTheme="Dark"
                Background="#F2141414"
                BorderThickness="1,0,0,0"
                BorderBrush="#1FFFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Height="44" Padding="12,0,6,0">
                        <TextBlock
                            Text="播放列表"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#F2FFFFFF"
                            VerticalAlignment="Center" />
                        <Button
                            Style="{StaticResource PlayerPanelIconButton}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="收起"
                            ToolTipService.ToolTip="收起"
                            Click="CollapsePlaylist_Click">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="#14FFFFFF">
                        <ListView
                            x:Name="PlaylistView"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource PlayerPanelListItem}"
                            CanReorderItems="True"
                            CanDragItems="True"
                            AllowDrop="True"
                            DoubleTapped="Playlist_DoubleTapped"
                            KeyDown="Playlist_KeyDown"
                            DragItemsCompleted="Playlist_Reordered">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29FFFFFF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33FFFFFF" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Error}"
                                            FontSize="11"
                                            Foreground="#FFFFB4B4"
                                            Opacity="0.85"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Grid Grid.Row="2" Padding="6,6,6,8" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PlaylistRepeatButton"
                            Style="{StaticResource PlayerPanelButton}"
                            AutomationProperties.Name="循环"
                            ToolTipService.ToolTip="循环"
                            Click="Repeat_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="PlaylistRepeatIcon" Glyph="&#xE8EE;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PlaylistRepeatText" Text="播完停止" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            x:Name="PlaylistShuffleButton"
                            Grid.Column="1"
                            Style="{StaticResource PlayerPanelIconToggleButton}"
                            AutomationProperties.Name="随机"
                            ToolTipService.ToolTip="随机"
                            Click="Shuffle_Click">
                            <FontIcon x:Name="PlaylistShuffleIcon" Glyph="&#xE8B1;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ToggleButton>
                        <Button
                            x:Name="PlaylistClearButton"
                            Grid.Column="2"
                            Style="{StaticResource PlayerPanelIconButton}"
                            AutomationProperties.Name="清空播放列表"
                            ToolTipService.ToolTip="清空播放列表"
                            Click="Clear_Click">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid
            x:Name="ControlsBar"
            Grid.Row="1"
            Padding="12,8,12,12"
            RowSpacing="4"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CurrentTimeText"
                    MinWidth="64"
                    Margin="0,0,10,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextAlignment="Right"
                    Text="00:00" />
                <Slider
                    x:Name="PositionBar"
                    Grid.Column="1"
                    Height="22"
                    Minimum="0"
                    Maximum="0"
                    Value="0"
                    StepFrequency="1"
                    IsTabStop="True"
                    AutomationProperties.Name="播放进度"
                    ValueChanged="Position_ValueChanged"
                    PointerPressed="Position_Pressed"
                    PointerReleased="Position_Released"
                    PointerCanceled="Position_Released"
                    PointerCaptureLost="Position_Released" />
                <TextBlock
                    x:Name="DurationTimeText"
                    Grid.Column="2"
                    MinWidth="64"
                    Margin="10,0,0,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextAlignment="Left"
                    Text="00:00" />
            </Grid>
            <Grid x:Name="ButtonsRow" Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    HorizontalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <Button
                                x:Name="OpenButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="打开"
                                ToolTipService.ToolTip="打开"
                                Click="Open_Click">
                                <FontIcon x:Name="OpenIcon" Glyph="&#xE8E5;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="OpenMenuButton"
                                Width="20"
                                Height="36"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="打开选项">
                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="OpenFlyout" Placement="Bottom" Opening="OpenFlyout_Opening">
                                        <MenuFlyoutItem
                                            x:Name="OpenFilesItem"
                                            Text="打开文件"
                                            Click="Open_Click" />
                                        <MenuFlyoutItem
                                            x:Name="FfmpegItem"
                                            Text="用 FFmpeg 打开当前项"
                                            Click="Ffmpeg_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                x:Name="StopButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="停止"
                                ToolTipService.ToolTip="停止"
                                Click="Stop_Click">
                                <FontIcon x:Name="StopIcon" Glyph="&#xE71A;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="PreviousButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="上一个"
                                ToolTipService.ToolTip="上一个"
                                Click="Previous_Click">
                                <FontIcon x:Name="PreviousIcon" Glyph="&#xE892;" FontSize="16" />
                            </Button>
                            <Grid Width="124" VerticalAlignment="Center">
                                <Button
                                    x:Name="SeekBackButton"
                                    Style="{StaticResource PlayerSeekBackButton}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="后退 5 秒"
                                    ToolTipService.ToolTip="后退 5 秒"
                                    Click="SeekBack_Click">
                                    <FontIcon x:Name="SeekBackIcon" Glyph="&#xED3C;" FontSize="16" />
                                </Button>
                                <Button
                                    x:Name="SeekForwardButton"
                                    Style="{StaticResource PlayerSeekForwardButton}"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="前进 5 秒"
                                    ToolTipService.ToolTip="前进 5 秒"
                                    Click="SeekForward_Click">
                                    <FontIcon x:Name="SeekForwardIcon" Glyph="&#xED3D;" FontSize="16" />
                                </Button>
                                <Button
                                    x:Name="PlayButton"
                                    Style="{StaticResource PlayerPlayButton}"
                                    HorizontalAlignment="Left"
                                    Margin="38,0,0,0"
                                    AutomationProperties.Name="播放/暂停"
                                    ToolTipService.ToolTip="播放/暂停"
                                    Click="Play_Click">
                                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="20" />
                                </Button>
                            </Grid>
                            <Button
                                x:Name="NextButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="下一个"
                                ToolTipService.ToolTip="下一个"
                                Click="Next_Click">
                                <FontIcon x:Name="NextIcon" Glyph="&#xE893;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="StepFrameButton"
                                Style="{StaticResource PlayerIconButton}"
                                AutomationProperties.Name="下一帧"
                                ToolTipService.ToolTip="下一帧"
                                IsEnabled="False"
                                Click="StepFrame_Click">
                                <FontIcon x:Name="StepFrameIcon" Glyph="&#xE1A5;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="MuteButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="静音"
                            ToolTipService.ToolTip="静音"
                            Click="Mute_Click">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE995;" FontSize="16" />
                        </ToggleButton>
                        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Volume_Changed" />
                    </StackPanel>
                    <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                    <Button
                        x:Name="SpeedButton"
                        Style="{StaticResource PlayerSpeedButton}"
                        AutomationProperties.Name="倍速"
                        ToolTipService.ToolTip="倍速">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="SpeedIcon" Glyph="&#xEC57;" FontSize="16" />
                            <TextBlock x:Name="SpeedText" Text="1.0×" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="SpeedFlyout" Placement="Bottom" Opening="SpeedFlyout_Opening">
                                <RadioMenuFlyoutItem
                                    x:Name="Speed05Item"
                                    Text="0.5×"
                                    GroupName="Speed"
                                    Tag="0.5"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed075Item"
                                    Text="0.75×"
                                    GroupName="Speed"
                                    Tag="0.75"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed10Item"
                                    Text="1.0×"
                                    GroupName="Speed"
                                    Tag="1.0"
                                    IsChecked="True"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed125Item"
                                    Text="1.25×"
                                    GroupName="Speed"
                                    Tag="1.25"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed15Item"
                                    Text="1.5×"
                                    GroupName="Speed"
                                    Tag="1.5"
                                    Click="SpeedItem_Click" />
                                <RadioMenuFlyoutItem
                                    x:Name="Speed20Item"
                                    Text="2.0×"
                                    GroupName="Speed"
                                    Tag="2.0"
                                    Click="SpeedItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="AudioButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="音轨"
                        ToolTipService.ToolTip="音轨"
                        IsEnabled="False">
                        <FontIcon x:Name="AudioIcon" Glyph="&#xE8D6;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="AudioFlyout" Placement="Bottom" Opening="AudioFlyout_Opening" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="SubtitleButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="字幕"
                        ToolTipService.ToolTip="字幕">
                        <FontIcon x:Name="SubtitleIcon" Glyph="&#xED1E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SubtitleFlyout" Placement="Bottom" Opening="SubtitleFlyout_Opening" />
                        </Button.Flyout>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button
                            x:Name="RepeatButton"
                            Style="{StaticResource PlayerIconButton}"
                            AutomationProperties.Name="循环"
                            ToolTipService.ToolTip="循环"
                            Click="Repeat_Click">
                            <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <ToggleButton
                            x:Name="ShuffleButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="随机"
                            ToolTipService.ToolTip="随机"
                            Click="Shuffle_Click">
                            <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ToggleButton>
                    </StackPanel>
                    <Rectangle Width="1" Height="20" Fill="#337F7F7F" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button
                            x:Name="SnapshotButton"
                            Style="{StaticResource PlayerIconButton}"
                            AutomationProperties.Name="截图"
                            ToolTipService.ToolTip="截图"
                            IsEnabled="False"
                            Click="Snapshot_Click">
                            <FontIcon x:Name="SnapshotIcon" Glyph="&#xE722;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="AspectButton"
                            Style="{StaticResource PlayerIconButton}"
                            AutomationProperties.Name="画面比例"
                            ToolTipService.ToolTip="画面比例">
                            <FontIcon x:Name="AspectIcon" Glyph="&#xE7F4;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="AspectFlyout" Placement="Bottom" Opening="AspectFlyout_Opening">
                                    <RadioMenuFlyoutItem
                                        x:Name="AspectFitItem"
                                        Text="适应"
                                        GroupName="Aspect"
                                        Tag="Fit"
                                        IsChecked="True"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="AspectFillItem"
                                        Text="填充"
                                        GroupName="Aspect"
                                        Tag="Fill"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="AspectStretchItem"
                                        Text="拉伸"
                                        GroupName="Aspect"
                                        Tag="Stretch"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="Aspect16x9Item"
                                        Text="16:9"
                                        GroupName="Aspect"
                                        Tag="Ratio16x9"
                                        Click="AspectItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="Aspect4x3Item"
                                        Text="4:3"
                                        GroupName="Aspect"
                                        Tag="Ratio4x3"
                                        Click="AspectItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ToggleButton
                            x:Name="FitWindowButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="自适应窗口"
                            ToolTipService.ToolTip="自适应窗口"
                            Click="FitWindow_Click">
                            <FontIcon x:Name="FitWindowIcon" Glyph="&#xE7C4;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="AlwaysOnTopButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="置顶"
                            ToolTipService.ToolTip="置顶"
                            Click="AlwaysOnTop_Click">
                            <FontIcon x:Name="AlwaysOnTopIcon" Glyph="&#xE840;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="PlaylistButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            AutomationProperties.Name="播放列表"
                            ToolTipService.ToolTip="播放列表"
                            Click="PlaylistButton_Click">
                            <FontIcon x:Name="PlaylistIcon" Glyph="&#xE90A;" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="PipelineButton"
                            Style="{StaticResource PlayerIconToggleButton}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="管线信息"
                            ToolTipService.ToolTip="管线信息"
                            Click="Pipeline_Click">
                            <FontIcon x:Name="PipelineIcon" Glyph="&#xE946;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                    <Button
                        x:Name="MoreButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="更多"
                        ToolTipService.ToolTip="更多">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <ToggleMenuFlyoutItem
                                    x:Name="FitWindowMenuItem"
                                    Text="自适应窗口"
                                    Click="FitWindowMenu_Click" />
                                <ToggleMenuFlyoutItem
                                    x:Name="AlwaysOnTopMenuItem"
                                    Text="窗口置顶"
                                    Click="AlwaysOnTopMenu_Click" />
                                <ToggleMenuFlyoutItem
                                    x:Name="PipelineMenuItem"
                                    Text="管线信息"
                                    Click="Pipeline_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="FullscreenButton"
                        Style="{StaticResource PlayerIconButton}"
                        AutomationProperties.Name="全屏"
                        ToolTipService.ToolTip="全屏"
                        Click="Fullscreen_Click">
                        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                    </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
