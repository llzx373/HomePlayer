@@ -0,0 +1,153 @@
+using System.Text.Json;
+using HomePlayer.Core;
+using HomePlayer.Ffmpeg;
+
+namespace HomePlayer.AI;
+
+public sealed record SpeakerSegment(int Speaker, double StartSeconds, double EndSeconds);
+
+/// <summary>
+/// 说话人分析结果，持有临时提取的音轨；释放时删除临时目录。
+/// </summary>
+public sealed class SpeakerAnalysis : IDisposable
+{
+    private readonly string _directory;
+
+    internal SpeakerAnalysis(string directory, string audioPath, IReadOnlyList<SpeakerSegment> segments)
+    {
+        _directory = directory;
+        AudioPath = audioPath;
+        Segments = segments;
+    }
+
+    /// <summary>测试用：不持有临时目录。</summary>
+    public SpeakerAnalysis(string audioPath, IReadOnlyList<SpeakerSegment> segments)
+    {
+        _directory = "";
+        AudioPath = audioPath;
+        Segments = segments;
+    }
+
+    public string AudioPath { get; }
+
+    public IReadOnlyList<SpeakerSegment> Segments { get; }
+
+    public int SpeakerCount => Segments.Select(segment => segment.Speaker).Distinct().Count();
+
+    public void Dispose()
+    {
+        try
+        {
+            if (Directory.Exists(_directory))
+                Directory.Delete(_directory, true);
+        }
+        catch (IOException)
+        {
+        }
+    }
+}
+
+public sealed class SpeakerAnalysisService(AiModelManager models, Func<string> mirror)
+{
+    private static readonly JsonSerializerOptions Json = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        PropertyNameCaseInsensitive = true
+    };
+
+    public async Task<SpeakerAnalysis> AnalyzeAsync(
+        string mediaPath,
+        int audioTrackIndex,
+        AiComputeDevice device,
+        IProgress<AiSubtitleProgress>? progress,
+        CancellationToken cancellationToken)
+    {
+        var segmentationModel = AiSubtitleCatalog.Model("diarization-segmentation");
+        var embeddingModel = AiSubtitleCatalog.Model("speaker-embedding");
+        Report(progress, "检查说话人模型", 0.02);
+        var segmentationDirectory = await models.EnsureArchiveAsync(segmentationModel, mirror(),
+            new Progress<double>(value => Report(progress, "下载说话人分割模型", value * 0.4)), cancellationToken);
+        var embeddingPath = await models.EnsureAsync(embeddingModel, mirror(),
+            new Progress<double>(value => Report(progress, "下载声纹模型", 0.4 + value * 0.4)), cancellationToken);
+
+        var directory = Path.Combine(AppPaths.AiTemp, "speakers-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var audioPath = Path.Combine(directory, "audio.wav");
+            Report(progress, "提取音轨", 0.82);
+            await Task.Run(() => FfmpegAudioExtractor.ExtractWav(mediaPath, audioTrackIndex, audioPath, cancellationToken), cancellationToken);
+
+            var job = new DiarizeJob(
+                audioPath,
+                Path.Combine(segmentationDirectory, "model.onnx"),
+                embeddingPath,
+                device == AiComputeDevice.Cuda,
+                300);
+            var jobPath = Path.Combine(directory, "diarize.json");
+            File.WriteAllText(jobPath, JsonSerializer.Serialize(job, Json));
+
+            Report(progress, "分析说话人", 0.85);
+            var segments = new List<SpeakerSegment>();
+            var done = false;
+            await AiProcess.RunAsync(AiRuntime.SherpaWorkerExecutable, ["--diarize", jobPath], AiRuntime.SherpaWorkerDirectory,
+                line =>
+                {
+                    if (!line.StartsWith('{'))
+                        return;
+                    try
+                    {
+                        using var document = JsonDocument.Parse(line);
+                        var root = document.RootElement;
+                        if (!root.TryGetProperty("type", out var type))
+                            return;
+                        if (type.GetString() == "done")
+                        {
+                            done = true;
+                            return;
+                        }
+
+                        if (type.GetString() != "segment"
+                            || !root.TryGetProperty("speaker", out var speaker)
+                            || !root.TryGetProperty("start", out var start)
+                            || !root.TryGetProperty("end", out var end))
+                            return;
+                        var id = speaker.GetInt32();
+                        if (id < 0)
+                            return;
+                        segments.Add(new SpeakerSegment(id, start.GetDouble(), end.GetDouble()));
+                    }
+                    catch (JsonException)
+                    {
+                    }
+                }, cancellationToken);
+
+            if (!done && segments.Count == 0)
+                throw new InvalidOperationException("说话人分析没有返回结果。");
+            Report(progress, "说话人分析完成", 1);
+            return new SpeakerAnalysis(directory, audioPath, segments);
+        }
+        catch
+        {
+            try
+            {
+                Directory.Delete(directory, true);
+            }
+            catch (IOException)
+            {
+            }
+
+            throw;
+        }
+    }
+
+    private static void Report(IProgress<AiSubtitleProgress>? progress, string stage, double value) =>
+        progress?.Report(new AiSubtitleProgress(stage, Math.Clamp(value, 0, 1)));
+
+    private sealed record DiarizeJob(
+        string AudioPath,
+        string SegmentationModel,
+        string EmbeddingModel,
+        bool UseCuda,
+        double BlockSeconds);
+}
diff --git a/src/HomePlayer.AI/SpeakerVoicePlanner.cs b/src/HomePlayer.AI/SpeakerVoicePlanner.cs
new file mode 100644
index 0000000..0dffe23
--- /dev/null
+++ b/src/HomePlayer.AI/SpeakerVoicePlanner.cs
@@ -0,0 +1,238 @@
+using HomePlayer.Core;
+
+namespace HomePlayer.AI;
+
+public sealed record SpeakerReference(int Speaker, string AudioPath, string Transcript);
+
+/// <summary>
+/// 把字幕句分配到说话人，并按音高给每个说话人挑一个预设音色。
+/// 跨语言音色克隆在本模型的 ONNX 版本上效果不可用，所以这里先用预设音色区分角色。
+/// </summary>
+public static class SpeakerVoicePlanner
+{
+    public static IReadOnlyDictionary<int, string> Assign(
+        IReadOnlyList<SubtitleCue> cues,
+        SpeakerAnalysis analysis,
+        IReadOnlyList<VoiceProfile> voices)
+    {
+        var result = new Dictionary<int, string>();
+        if (voices.Count == 0 || analysis.Segments.Count == 0)
+            return result;
+
+        var bySpeaker = new Dictionary<int, List<int>>();
+        for (var index = 0; index < cues.Count; index++)
+        {
+            var speaker = DominantSpeaker(cues[index], analysis.Segments);
+            if (speaker < 0)
+                continue;
+            if (!bySpeaker.TryGetValue(speaker, out var list))
+                bySpeaker[speaker] = list = [];
+            list.Add(index);
+        }
+
+        var female = voices.FirstOrDefault(voice => voice.Id.Contains("female", StringComparison.OrdinalIgnoreCase));
+        var male = voices.FirstOrDefault(voice =>
+            voice.Id.Contains("male", StringComparison.OrdinalIgnoreCase)
+            && !voice.Id.Contains("female", StringComparison.OrdinalIgnoreCase));
+
+        foreach (var (_, indices) in bySpeaker.OrderBy(pair => pair.Key))
+        {
+            var longest = indices
+                .OrderByDescending(index => (cues[index].End - cues[index].Start).TotalSeconds)
+                .First();
+            var pitch = MedianPitch(analysis.AudioPath, cues[longest].Start, cues[longest].End);
+            var voice = pitch > 0 && pitch < 165 ? male ?? female : female ?? male;
+            voice ??= voices[0];
+            foreach (var index in indices)
+                result[index] = voice.Id;
+        }
+
+        return result;
+    }
+
+    /// <summary>
+    /// VoxCPM 用：给每个说话人切一段参考音频（最长的那句），并带上该句原文作为逐字稿。
+    /// </summary>
+    public static IReadOnlyDictionary<int, SpeakerReference> AssignReferences(
+        IReadOnlyList<SubtitleCue> cues,
+        SpeakerAnalysis analysis,
+        string directory)
+    {
+        var result = new Dictionary<int, SpeakerReference>();
+        var groups = GroupBySpeaker(cues, analysis.Segments);
+        if (groups.Count == 0)
+            return result;
+
+        Directory.CreateDirectory(directory);
+        foreach (var (speaker, indices) in groups.OrderBy(pair => pair.Key))
+        {
+            var longest = indices
+                .OrderByDescending(index => (cues[index].End - cues[index].Start).TotalSeconds)
+                .First();
+            var path = Path.Combine(directory, $"speaker-{speaker}.wav");
+            if (!CutReference(analysis.AudioPath, cues[longest].Start, cues[longest].End, path))
+                continue;
+            var reference = new SpeakerReference(speaker, path, cues[longest].Text.Trim());
+            foreach (var index in indices)
+                result[index] = reference;
+        }
+
+        return result;
+    }
+
+    private static Dictionary<int, List<int>> GroupBySpeaker(IReadOnlyList<SubtitleCue> cues, IReadOnlyList<SpeakerSegment> segments)
+    {
+        var groups = new Dictionary<int, List<int>>();
+        for (var index = 0; index < cues.Count; index++)
+        {
+            var speaker = DominantSpeaker(cues[index], segments);
+            if (speaker < 0)
+                continue;
+            if (!groups.TryGetValue(speaker, out var list))
+                groups[speaker] = list = [];
+            list.Add(index);
+        }
+
+        return groups;
+    }
+
+    private static bool CutReference(string audioPath, TimeSpan from, TimeSpan to, string outputPath, double maxSeconds = 10)
+    {
+        try
+        {
+            var info = WavFile.ReadInfo(audioPath);
+            if (info.Channels != 1 || info.SampleRate < 8000)
+                return false;
+            var rate = info.SampleRate;
+            var first = Math.Max(0, (int)(from.TotalSeconds * rate));
+            var last = Math.Min((int)info.Frames, (int)(to.TotalSeconds * rate));
+            last = Math.Min(last, first + (int)(maxSeconds * rate));
+            if (last - first < rate / 2)
+                return false;
+
+            using var stream = new FileStream(audioPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+            stream.Position = info.DataOffset + first * 2L;
+            var bytes = new byte[(last - first) * 2];
+            stream.ReadExactly(bytes);
+            var samples = new short[bytes.Length / 2];
+            Buffer.BlockCopy(bytes, 0, samples, 0, bytes.Length);
+            WavFile.WritePcm16(outputPath, samples, rate, 1);
+            return true;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException)
+        {
+            return false;
+        }
+    }
+
+    private static int DominantSpeaker(SubtitleCue cue, IReadOnlyList<SpeakerSegment> segments)
+    {
+        var best = -1;
+        var bestOverlap = 0.1;
+        var start = cue.Start.TotalSeconds;
+        var end = cue.End.TotalSeconds;
+        foreach (var segment in segments)
+        {
+            var overlap = Math.Min(end, segment.EndSeconds) - Math.Max(start, segment.StartSeconds);
+            if (overlap > bestOverlap)
+            {
+                bestOverlap = overlap;
+                best = segment.Speaker;
+            }
+        }
+
+        return best;
+    }
+
+    internal static double MedianPitch(string audioPath, TimeSpan from, TimeSpan to)
+    {
+        try
+        {
+            var info = WavFile.ReadInfo(audioPath);
+            if (info.Channels != 1 || info.SampleRate < 8000)
+                return 0;
+            var rate = info.SampleRate;
+            var first = Math.Max(0, (int)(from.TotalSeconds * rate));
+            var last = Math.Min((int)info.Frames, (int)(to.TotalSeconds * rate));
+            if (last - first < rate / 2)
+                return 0;
+
+            using var stream = new FileStream(audioPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+            stream.Position = info.DataOffset + first * 2L;
+            var bytes = new byte[(last - first) * 2];
+            stream.ReadExactly(bytes);
+            var samples = new short[bytes.Length / 2];
+            Buffer.BlockCopy(bytes, 0, samples, 0, bytes.Length);
+
+            var frame = rate * 40 / 1000;
+            var hop = rate * 20 / 1000;
+            var minLag = rate / 350;
+            var maxLag = rate / 70;
+            var estimates = new List<double>();
+            for (var offset = 0; offset + frame + maxLag <= samples.Length; offset += hop)
+            {
+                double energy = 0;
+                for (var index = 0; index < frame; index++)
+                    energy += samples[offset + index] * (double)samples[offset + index];
+                if (energy / frame < 1e-4)
+                    continue;
+
+                var bestScore = 0.0;
+                var scores = new double[maxLag - minLag + 1];
+                for (var lag = minLag; lag <= maxLag; lag++)
+                {
+                    double sum = 0, left = 0, right = 0;
+                    for (var index = 0; index < frame; index++)
+                    {
+                        double a = samples[offset + index];
+                        double b = samples[offset + index + lag];
+                        sum += a * b;
+                        left += a * a;
+                        right += b * b;
+                    }
+
+                    var score = sum / (Math.Sqrt(left * right) + 1e-9);
+                    scores[lag - minLag] = score;
+                    if (score > bestScore)
+                        bestScore = score;
+                }
+
+                if (bestScore <= 0.5)
+                    continue;
+
+                // 全局峰值可能是真实周期的整数倍，若某个更短的周期同样接近峰值则取它。
+                var bestLag = 0;
+                for (var lag = minLag; lag <= maxLag; lag++)
+                {
+                    if (scores[lag - minLag] >= bestScore)
+                    {
+                        bestLag = lag;
+                        break;
+                    }
+                }
+
+                for (var divisor = 2; divisor <= 3; divisor++)
+                {
+                    var candidate = bestLag / divisor;
+                    if (candidate >= minLag && scores[candidate - minLag] >= bestScore * 0.85)
+                    {
+                        bestLag = candidate;
+                        break;
+                    }
+                }
+
+                if (bestLag > 0)
+                    estimates.Add(rate / (double)bestLag);
+            }
+
+            if (estimates.Count < 4)
+                return 0;
+            estimates.Sort();
+            return estimates[estimates.Count / 2];
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException)
+        {
+            return 0;
+        }
+    }
+}
