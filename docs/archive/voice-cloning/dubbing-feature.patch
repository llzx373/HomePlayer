+    /// <summary>
+    /// 音色模仿：不等说话人分离出结果，先用播放头附近第一句够长的台词切一段参考音频，
+    /// 把它作为默认音色。这样开场几句不会一直用系统预设音色，分离结果稍后再覆盖。
+    /// </summary>
+    private void EnsureDefaultClone()
+    {
+        if (!_cloneVoice || _engine != DubbingEngine.CosyVoice)
+            return;
+
+        LiveDubbingCue? cue;
+        lock (_speakerGate)
+        {
+            if (_defaultCloneReady || _defaultCloneStarted || _cutReference == null
+                || _cosyVoice == null || _workDirectory == null || DateTime.UtcNow < _defaultCloneRetryAt)
+                return;
+            cue = _cues
+                .OrderBy(item => item.Start)
+                .FirstOrDefault(IsGoodCloneCue);
+            if (cue == null)
+                return;
+            _defaultCloneStarted = true;
+        }
+
+        _ = Task.Run(() => PrepareDefaultVoiceAsync(cue), _cancel.Token);
+    }
+
+    /// <summary>
+    /// 太长的段落经常夹着大段静音或音乐，文本又很少，不适合当音色参考；
+    /// 优先用长度和文字量都合理的句子。
+    /// </summary>
+    private static bool IsGoodCloneCue(LiveDubbingCue cue)
+    {
+        if (string.IsNullOrWhiteSpace(cue.Text))
+            return false;
+        var duration = cue.End - cue.Start;
+        if (duration < 1.5 || duration > 10)
+            return false;
+        var compact = cue.Text.Count(char.IsLetterOrDigit);
+        if (compact < 4)
+            return false;
+        return compact / duration >= 1.5 || duration <= 4;
+    }
+
+    private async Task PrepareDefaultVoiceAsync(LiveDubbingCue cue)
+    {
+        try
+        {
+            string? workDirectory;
+            Func<double, double, string, bool>? cut;
+            CosyVoiceService? service;
+            lock (_speakerGate)
+            {
+                workDirectory = _workDirectory;
+                cut = _cutReference;
+                service = _cosyVoice;
+            }
+
+            if (workDirectory == null || cut == null || service == null)
+                return;
+            var reference = Path.Combine(workDirectory, "ref-default.wav");
+            if (!cut(cue.Start, cue.End, reference))
+                return;
+
+            await _promptGate.WaitAsync(_cancel.Token);
+            try
+            {
+                var cacheId = "live-default-" + Fingerprint(reference, cue.Text);
+                var prompt = Path.Combine(AppPaths.DubbingCache, "voices", cacheId + ".gguf");
+                if (!File.Exists(prompt))
+                {
+                    var prepared = await service.PrepareVoiceAsync(cacheId, reference, cue.Text, _cancel.Token);
+                    if (!string.Equals(prepared, prompt, StringComparison.OrdinalIgnoreCase) && File.Exists(prepared))
+                        File.Move(prepared, prompt, true);
+                }
+
+                lock (_speakerGate)
+                {
+                    _voicePrompts["default"] = prompt;
+                    _voicePromptsDirty = true;
+                    _defaultCloneReady = true;
+                }
+            }
+            finally
+            {
+                _promptGate.Release();
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        catch (Exception ex)
+        {
+            lock (_gate)
+                _lastError = "准备模仿音色失败：" + ex.Message;
+        }
+        finally
+        {
+            lock (_speakerGate)
+            {
+                _defaultCloneStarted = false;
+                if (!_defaultCloneReady)
+                    _defaultCloneRetryAt = DateTime.UtcNow.AddSeconds(2);
+            }
+        }
+    }
+
+    private void EnsureVoiceLocked(int speaker)
+    {
+        if (_speakerVoices.ContainsKey(speaker))
+            return;
+        if (_engine != DubbingEngine.CosyVoice)
+        {
+            _speakerVoices[speaker] = PickPresetLocked(speaker);
+            return;
+        }
+
+        if (speaker < 0 || speaker >= MaxLiveSpeakers)
+            return;
+        if (_promptPreparing.Contains(speaker) || _cosyVoice == null || _cutReference == null)
+            return;
+        var cue = LongestCueForSpeakerLocked(speaker);
+        if (cue == null)
+            return;
+        _promptPreparing.Add(speaker);
+        _ = Task.Run(() => PrepareSpeakerVoiceAsync(speaker, cue), _cancel.Token);
+    }
+
+    private LiveDubbingCue? LongestCueForSpeakerLocked(int speaker)
+    {
+        LiveDubbingCue? best = null;
+        foreach (var cue in _cues)
+        {
+            if (!_cueSpeakers.TryGetValue(cue.Key, out var assigned) || assigned != speaker)
+                continue;
+            if (!IsGoodCloneCue(cue))
+                continue;
+            if (best == null || cue.End - cue.Start > best.End - best.Start)
+                best = cue;
+        }
+
+        return best;
+    }
+
+    private async Task PrepareSpeakerVoiceAsync(int speaker, LiveDubbingCue cue)
+    {
+        var acquired = false;
+        try
+        {
+            await _promptGate.WaitAsync(_cancel.Token);
+            acquired = true;
+            string? workDirectory;
+            Func<double, double, string, bool>? cut;
+            CosyVoiceService? service;
+            lock (_speakerGate)
+            {
+                workDirectory = _workDirectory;
+                cut = _cutReference;
+                service = _cosyVoice;
+            }
+
+            if (workDirectory == null || cut == null || service == null)
+                return;
+            var reference = Path.Combine(workDirectory, $"ref-speaker-{speaker}.wav");
+            if (!cut(cue.Start, cue.End, reference))
+                return;
+
+            var cacheId = "live-" + Fingerprint(reference, cue.Text);
+            var prompt = Path.Combine(AppPaths.DubbingCache, "voices", cacheId + ".gguf");
+            if (!File.Exists(prompt))
+            {
+                var prepared = await service.PrepareVoiceAsync(cacheId, reference, cue.Text, _cancel.Token);
+                if (!string.Equals(prepared, prompt, StringComparison.OrdinalIgnoreCase) && File.Exists(prepared))
+                    File.Move(prepared, prompt, true);
+            }
+
+            lock (_speakerGate)
+            {
+                _voicePrompts["speaker-" + speaker] = prompt;
+                _voicePromptsDirty = true;
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        catch (Exception ex)
+        {
+            lock (_gate)
+                _lastError = "准备角色音色失败：" + ex.Message;
+        }
+        finally
+        {
+            if (acquired)
+                _promptGate.Release();
+            lock (_speakerGate)
+                _promptPreparing.Remove(speaker);
+        }
+    }
+
+    private async Task SyncVoicesAsync(CancellationToken cancellationToken)
+    {
+        Dictionary<string, string>? prompts;
+        lock (_speakerGate)
+        {
+            if (!_voicePromptsDirty)
+                return;
+            _voicePromptsDirty = false;
+            prompts = new Dictionary<string, string>(_voicePrompts, StringComparer.Ordinal);
+        }
+
+        var service = _cosyVoice;
+        if (service == null)
+            return;
+        try
+        {
+            await service.SwapVoicesAsync(prompts, cancellationToken);
+            lock (_speakerGate)
+            {
+                foreach (var name in prompts.Keys)
+                {
+                    if (!name.StartsWith("speaker-", StringComparison.Ordinal))
+                        continue;
+                    if (int.TryParse(name["speaker-".Length..], NumberStyles.Integer, CultureInfo.InvariantCulture, out var speaker))
+                        _speakerVoices[speaker] = name;
+                }
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            lock (_gate)
+                _lastError = "切换角色音色失败：" + ex.Message;
+        }
+    }
+
+    private static string Fingerprint(string audioPath, string text)
+    {
+        using var stream = File.OpenRead(audioPath);
+        var audio = Convert.ToHexString(SHA256.HashData(stream))[..16].ToLowerInvariant();
+        var transcript = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(text)))[..16].ToLowerInvariant();
+        return audio + "-" + transcript;
+    }
+
+    private string PickPresetLocked(int speaker)
+    {
+        if (_voices.Count == 0)
+            return _defaultVoice.Id;
+        var used = new HashSet<string>(_speakerVoices.Values, StringComparer.Ordinal);
+        var start = Math.Abs(speaker) % _voices.Count;
+        for (var offset = 0; offset < _voices.Count; offset++)
+        {
+            var voice = _voices[(start + offset) % _voices.Count];
+            if (!used.Contains(voice.Id))
+                return voice.Id;
+        }
+
+        return _voices[start].Id;
+    }
+
+    private string VoiceIdFor(int speaker)
+    {
+        if (speaker >= 0)
+        {
+            lock (_speakerGate)
+            {
+                if (_separateSpeakers && _speakerVoices.TryGetValue(speaker, out var id))
+                    return id;
+            }
+        }
+
+        return _engine == DubbingEngine.CosyVoice ? "default" : _defaultVoice.Id;
+    }
+
+    private Task<(int SampleRate, long Samples)> SynthesizeAsync(string text, string voiceId, string path, CancellationToken cancellationToken) =>
+        _cosyVoice != null
+            ? _cosyVoice.SynthesizeAsync(text, voiceId, path, cancellationToken)
+            : _zipVoice!.SynthesizeAsync(text, voiceId, path, 2, cancellationToken);
+
+    private static long KeyOf(SubtitleCue cue) => (long)Math.Round(cue.Start.TotalMilliseconds);
+
+    /// <summary>
+    /// 选择了音色模仿时，先等第一段克隆音色准备好，避免开场几句先用系统预设音色。
+    /// 等不到（例如没有合适台词）就按预设音色继续，后台仍然会继续尝试。
+    /// </summary>
+    private bool ShouldWaitForDefaultClone() =>
+        _cloneVoice
+        && _engine == DubbingEngine.CosyVoice
+        && _cutReference != null
+        && !_defaultCloneReady
+        && DateTime.UtcNow - _startedAt < TimeSpan.FromSeconds(8);
+
+    private static string VoiceKey(VoiceProfile voice)
+    {
+        var info = File.Exists(voice.AudioPath) ? new FileInfo(voice.AudioPath) : null;
+        var fingerprint = string.Join('|',
+            voice.Id,
+            voice.AudioPath.ToLowerInvariant(),
+            info?.Length.ToString(CultureInfo.InvariantCulture) ?? "0",
+            info?.LastWriteTimeUtc.Ticks.ToString(CultureInfo.InvariantCulture) ?? "0",
+            voice.ReferenceText);
+        return Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(fingerprint)))[..16].ToLowerInvariant();
+    }
+
+    private static void Report(IProgress<AiSubtitleProgress>? progress, string stage, double value) =>
+        progress?.Report(new AiSubtitleProgress(stage, Math.Clamp(value, 0, 1)));
+
+    private sealed record LiveDubbingCue(long Key, double Start, double End, string Text);
+}
diff --git a/src/HomePlayer.AI/LiveSpeakerService.cs b/src/HomePlayer.AI/LiveSpeakerService.cs
new file mode 100644
index 0000000..f454bef
--- /dev/null
+++ b/src/HomePlayer.AI/LiveSpeakerService.cs
@@ -0,0 +1,217 @@
+using System.Text;
+using System.Text.Json;
+using HomePlayer.Core;
+using HomePlayer.Ffmpeg;
+
+namespace HomePlayer.AI;
+
+/// <summary>
+/// 实时说话人分析：从当前位置抽一份 WAV，交给 SherpaWorker 的流式分离模式，
+/// 增量维护 <see cref="LiveSpeakerTimeline"/>。分析和识别各用一份音轨，互不阻塞。
+/// </summary>
+public sealed class LiveSpeakerService : IAsyncDisposable
+{
+    private const double BlockSeconds = 60;
+    private const double OverlapSeconds = 10;
+
+    private readonly AiModelManager _models;
+    private readonly Func<string> _mirror;
+    private readonly LiveSpeakerTimeline _timeline = new();
+    private readonly CancellationTokenSource _cancel = new();
+    private readonly object _gate = new();
+    private string? _directory;
+    private string? _audioPath;
+    private double _startSeconds;
+    private Task? _extraction;
+    private Task? _run;
+    private string? _lastError;
+    private int _disposed;
+
+    public LiveSpeakerService(AiModelManager models, Func<string> mirror)
+    {
+        _models = models;
+        _mirror = mirror;
+    }
+
+    public LiveSpeakerTimeline Timeline => _timeline;
+
+    public string? AudioPath => _audioPath;
+
+    public double StartSeconds => _startSeconds;
+
+    public string? LastError
+    {
+        get
+        {
+            lock (_gate)
+                return _lastError;
+        }
+    }
+
+    public async Task StartAsync(
+        string mediaPath,
+        int audioTrackIndex,
+        double startSeconds,
+        AiComputeDevice device,
+        IProgress<AiSubtitleProgress>? progress,
+        CancellationToken cancellationToken)
+    {
+        var segmentationModel = AiSubtitleCatalog.Model("diarization-segmentation");
+        var embeddingModel = AiSubtitleCatalog.Model("speaker-embedding");
+        Report(progress, "检查说话人模型", 0.02);
+        var segmentationDirectory = await _models.EnsureArchiveAsync(segmentationModel, _mirror(),
+            new Progress<double>(value => Report(progress, "下载说话人分割模型", value * 0.4)), cancellationToken);
+        var embeddingPath = await _models.EnsureAsync(embeddingModel, _mirror(),
+            new Progress<double>(value => Report(progress, "下载声纹模型", 0.4 + value * 0.4)), cancellationToken);
+
+        var directory = Path.Combine(AppPaths.AiTemp, "live-speakers-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        _directory = directory;
+        _startSeconds = Math.Max(0, startSeconds);
+        var audioPath = Path.Combine(directory, "audio.wav");
+        _audioPath = audioPath;
+
+        Report(progress, "提取说话人分析音轨", 0.82);
+        _extraction = Task.Run(() =>
+        {
+            try
+            {
+                FfmpegAudioExtractor.ExtractWav(mediaPath, audioTrackIndex, audioPath, _cancel.Token, _startSeconds);
+                File.WriteAllText(audioPath + ".done", "");
+            }
+            catch (OperationCanceledException)
+            {
+            }
+            catch (Exception ex)
+            {
+                try
+                {
+                    File.WriteAllText(audioPath + ".error", ex.Message);
+                }
+                catch (IOException)
+                {
+                }
+            }
+        }, CancellationToken.None);
+
+        var job = new LiveSpeakerJob(
+            audioPath,
+            Path.Combine(segmentationDirectory, "model.onnx"),
+            embeddingPath,
+            device != AiComputeDevice.Cpu && AiRuntime.HasNvidiaGpu,
+            BlockSeconds,
+            OverlapSeconds,
+            _startSeconds);
+        var jobPath = Path.Combine(directory, "job.json");
+        File.WriteAllText(jobPath, JsonSerializer.Serialize(job));
+
+        Report(progress, "分析说话人", 0.9);
+        _run = Task.Run(async () =>
+        {
+            try
+            {
+                await AiProcess.RunAsync(
+                    AiRuntime.SherpaWorkerExecutable,
+                    ["--diarize-live", jobPath],
+                    AiRuntime.SherpaWorkerDirectory,
+                    Parse,
+                    _cancel.Token);
+            }
+            catch (OperationCanceledException)
+            {
+            }
+            catch (Exception ex)
+            {
+                lock (_gate)
+                    _lastError = ex.Message;
+            }
+        }, CancellationToken.None);
+    }
+
+    public bool TryCutReference(double fromSeconds, double toSeconds, string outputPath)
+    {
+        var audioPath = _audioPath;
+        return audioPath != null
+            && LiveAudioClipReader.TryCut(audioPath, _startSeconds, fromSeconds, toSeconds, outputPath);
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0)
+            return;
+        _cancel.Cancel();
+        foreach (var task in new[] { _run, _extraction })
+        {
+            if (task == null)
+                continue;
+            try
+            {
+                await task;
+            }
+            catch
+            {
+            }
+        }
+
+        _cancel.Dispose();
+        var directory = _directory;
+        _directory = null;
+        if (directory != null)
+        {
+            try
+            {
+                if (Directory.Exists(directory))
+                    Directory.Delete(directory, true);
+            }
+            catch (IOException)
+            {
+            }
+        }
+    }
+
+    private void Parse(string line)
+    {
+        if (!line.StartsWith('{'))
+            return;
+        try
+        {
+            using var document = JsonDocument.Parse(line);
+            var root = document.RootElement;
+            if (!root.TryGetProperty("type", out var type))
+                return;
+            switch (type.GetString())
+            {
+                case "segment":
+                    if (root.TryGetProperty("speaker", out var speaker)
+                        && root.TryGetProperty("start", out var start)
+                        && root.TryGetProperty("end", out var end))
+                    {
+                        _timeline.Add(new LiveSpeakerSegment(
+                            speaker.GetInt32(),
+                            start.GetDouble(),
+                            end.GetDouble()));
+                    }
+                    break;
+                case "through":
+                    if (root.TryGetProperty("seconds", out var seconds))
+                        _timeline.SetThrough(seconds.GetDouble());
+                    break;
+            }
+        }
+        catch (JsonException)
+        {
+        }
+    }
+
+    private static void Report(IProgress<AiSubtitleProgress>? progress, string stage, double value) =>
+        progress?.Report(new AiSubtitleProgress(stage, Math.Clamp(value, 0, 1)));
+
+    private sealed record LiveSpeakerJob(
+        string AudioPath,
+        string SegmentationModel,
+        string EmbeddingModel,
+        bool UseCuda,
+        double BlockSeconds,
+        double OverlapSeconds,
+        double StartSeconds);
+}
