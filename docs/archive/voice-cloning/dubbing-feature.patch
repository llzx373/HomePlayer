new file mode 100644
index 0000000..621c5b9
--- /dev/null
+++ b/tests/HomePlayer.Core.Tests/LiveAudioClipReaderTests.cs
@@ -0,0 +1,99 @@
+namespace HomePlayer.Core.Tests;
+
+public class LiveAudioClipReaderTests
+{
+    [Fact]
+    public void Cuts_requested_range_from_complete_wav()
+    {
+        var root = CreateRoot();
+        try
+        {
+            var wav = Path.Combine(root, "audio.wav");
+            WriteWav(wav, seconds: 3);
+            var output = Path.Combine(root, "clip.wav");
+
+            Assert.True(LiveAudioClipReader.TryCut(wav, 0, 0.5, 2.5, output));
+            var (samples, rate, channels) = WavFile.ReadPcm16(output);
+            Assert.Equal(16000, rate);
+            Assert.Equal(1, channels);
+            Assert.Equal(32000, samples.Length);
+        }
+        finally
+        {
+            Directory.Delete(root, true);
+        }
+    }
+
+    [Fact]
+    public void Honors_extraction_start_offset()
+    {
+        var root = CreateRoot();
+        try
+        {
+            var wav = Path.Combine(root, "audio.wav");
+            WriteWav(wav, seconds: 3);
+            var output = Path.Combine(root, "clip.wav");
+
+            Assert.True(LiveAudioClipReader.TryCut(wav, dataStartSeconds: 100, fromSeconds: 100.5, toSeconds: 102.5, output));
+            var (samples, _, _) = WavFile.ReadPcm16(output);
+            Assert.Equal(32000, samples.Length);
+        }
+        finally
+        {
+            Directory.Delete(root, true);
+        }
+    }
+
+    [Fact]
+    public void Refuses_clip_shorter_than_minimum()
+    {
+        var root = CreateRoot();
+        try
+        {
+            var wav = Path.Combine(root, "audio.wav");
+            WriteWav(wav, seconds: 1);
+            var output = Path.Combine(root, "clip.wav");
+
+            Assert.False(LiveAudioClipReader.TryCut(wav, 0, 0.2, 0.8, output));
+        }
+        finally
+        {
+            Directory.Delete(root, true);
+        }
+    }
+
+    [Fact]
+    public void Clamps_to_available_data_in_growing_wav()
+    {
+        var root = CreateRoot();
+        try
+        {
+            var wav = Path.Combine(root, "audio.wav");
+            WriteWav(wav, seconds: 1);
+            var output = Path.Combine(root, "clip.wav");
+
+            Assert.True(LiveAudioClipReader.TryCut(wav, 0, 0, 3, output, maxSeconds: 10, minSeconds: 0.5));
+            var (samples, _, _) = WavFile.ReadPcm16(output);
+            Assert.Equal(16000, samples.Length);
+        }
+        finally
+        {
+            Directory.Delete(root, true);
+        }
+    }
+
+    private static string CreateRoot()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "HomePlayer-clip-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(root);
+        return root;
+    }
+
+    private static void WriteWav(string path, int seconds)
+    {
+        var samples = new short[seconds * 16000];
+        for (var index = 0; index < samples.Length; index++)
+            samples[index] = (short)(index % 1000);
+        WavFile.WritePcm16(path, samples, 16000, 1);
+    }
+}
diff --git a/tests/HomePlayer.Core.Tests/LiveDubbingSchedulerTests.cs b/tests/HomePlayer.Core.Tests/LiveDubbingSchedulerTests.cs
new file mode 100644
index 0000000..d012992
--- /dev/null
+++ b/tests/HomePlayer.Core.Tests/LiveDubbingSchedulerTests.cs
@@ -0,0 +1,119 @@
+using HomePlayer.Core;
+
+namespace HomePlayer.Core.Tests;
+
+public class LiveDubbingSchedulerTests
+{
+    [Fact]
+    public void Coverage_waits_for_translation_and_synthesis()
+    {
+        var scheduler = new LiveDubbingScheduler();
+        scheduler.Reset(0);
+        scheduler.SetRecognizedThrough(10);
+        scheduler.Track(1, 2, 4);
+        scheduler.Track(2, 6, 8);
+
+        Assert.Equal(2, scheduler.CoveredThrough);
+
+        scheduler.Translate(1, "你好");
+        scheduler.AssignSpeaker(1, 0);
+        Assert.Equal(2, scheduler.CoveredThrough);
+
+        var job = scheduler.Next(0, lookaheadSeconds: 20);
+        Assert.NotNull(job);
+        Assert.Equal(1, job!.Key);
+        Assert.Equal("你好", job.Text);
+        Assert.Equal(0, job.Speaker);
+
+        scheduler.Complete(1);
+        Assert.Equal(6, scheduler.CoveredThrough);
+
+        scheduler.Translate(2, "");
+        Assert.Equal(10, scheduler.CoveredThrough);
+    }
+
+    [Fact]
+    public void Coverage_waits_for_speaker()
+    {
+        var scheduler = new LiveDubbingScheduler();
+        scheduler.Reset(0);
+        scheduler.SetRecognizedThrough(10);
+        scheduler.Track(1, 2, 4);
+        scheduler.Translate(1, "你好");
+
+        Assert.Equal(2, scheduler.CoveredThrough);
+        Assert.Null(scheduler.Next(0, lookaheadSeconds: 20));
+
+        scheduler.AssignSpeaker(1, 3);
+        var job = scheduler.Next(0, lookaheadSeconds: 20);
+        Assert.NotNull(job);
+        Assert.Equal(3, job!.Speaker);
+    }
+
+    [Fact]
+    public void Expire_speakers_falls_back_to_default_voice()
+    {
+        var scheduler = new LiveDubbingScheduler();
+        scheduler.Reset(0);
+        scheduler.SetRecognizedThrough(10);
+        scheduler.Track(1, 2, 4);
+        scheduler.Translate(1, "你好");
+
+        Assert.Equal(2, scheduler.CoveredThrough, 3);
+        Assert.Equal(1, scheduler.ExpireSpeakers(diarizedThrough: 7, graceSeconds: 2));
+        Assert.Equal(2, scheduler.CoveredThrough, 3);
+
+        var job = scheduler.Next(0, lookaheadSeconds: 20);
+        Assert.NotNull(job);
+        Assert.Equal(-1, job!.Speaker);
+
+        scheduler.Complete(1);
+        Assert.Equal(10, scheduler.CoveredThrough, 3);
+    }
+
+    [Fact]
+    public void Next_skips_late_cues_and_respects_lookahead()
+    {
+        var scheduler = new LiveDubbingScheduler();
+        scheduler.Reset(0);
+        scheduler.SetRecognizedThrough(40);
+        scheduler.Track(1, 1, 2);
+        scheduler.Track(2, 30, 31);
+        scheduler.Translate(1, "第一句");
+        scheduler.Translate(2, "第二句");
+        scheduler.AssignSpeaker(1, 0);
+        scheduler.AssignSpeaker(2, 1);
+
+        Assert.Null(scheduler.Next(5, lookaheadSeconds: 20));
+        Assert.Equal(30, scheduler.CoveredThrough, 3);
+
+        var job = scheduler.Next(5, lookaheadSeconds: 30);
+        Assert.NotNull(job);
+        Assert.Equal(2, job!.Key);
+        Assert.Equal(1, job.Speaker);
+    }
+
+    [Fact]
+    public void Reset_clears_cues_and_advances_recognized_frontier()
+    {
+        var scheduler = new LiveDubbingScheduler();
+        scheduler.SetRecognizedThrough(50);
+        scheduler.Track(1, 10, 12);
+        scheduler.Reset(100);
+
+        Assert.Equal(100, scheduler.CoveredThrough, 3);
+        Assert.Null(scheduler.Next(0, lookaheadSeconds: 20));
+    }
+
+    [Fact]
+    public void Skip_releases_coverage_without_synthesis()
+    {
+        var scheduler = new LiveDubbingScheduler();
+        scheduler.Reset(0);
+        scheduler.SetRecognizedThrough(5);
+        scheduler.Track(1, 1, 2);
+        scheduler.Skip(1);
+
+        Assert.Equal(5, scheduler.CoveredThrough, 3);
+    }
+}
