new file mode 100644
index 0000000..d649acb
--- /dev/null
+++ b/src/HomePlayer.Core/LiveAudioClipReader.cs
@@ -0,0 +1,52 @@
+namespace HomePlayer.Core;
+
+/// <summary>
+/// 从还在增长的 WAV 中按绝对时间切片，用于实时配音的参考音频。
+/// 不依赖 WAV 头里的 data 大小，按文件实际长度计算可用样本。
+/// </summary>
+public static class LiveAudioClipReader
+{
+    public static bool TryCut(
+        string wavPath,
+        double dataStartSeconds,
+        double fromSeconds,
+        double toSeconds,
+        string outputPath,
+        double maxSeconds = 10,
+        double minSeconds = 1.5)
+    {
+        try
+        {
+            var info = WavFile.ReadInfo(wavPath);
+            if (info.Format != 1 || info.BitsPerSample != 16 || info.Channels != 1 || info.SampleRate < 8000)
+                return false;
+
+            var rate = info.SampleRate;
+            var first = Math.Max(0L, (long)Math.Round((fromSeconds - dataStartSeconds) * rate));
+            var last = Math.Max(0L, (long)Math.Round((toSeconds - dataStartSeconds) * rate));
+            if (last <= first)
+                return false;
+            last = Math.Min(last, first + (long)(maxSeconds * rate));
+
+            using var stream = new FileStream(wavPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+            var available = Math.Max(0, (stream.Length - info.DataOffset) / 2);
+            first = Math.Min(first, available);
+            last = Math.Min(last, available);
+            if (last - first < minSeconds * rate)
+                return false;
+
+            stream.Position = info.DataOffset + first * 2;
+            var count = checked((int)(last - first));
+            var samples = new short[count];
+            var bytes = new byte[count * 2];
+            stream.ReadExactly(bytes);
+            Buffer.BlockCopy(bytes, 0, samples, 0, bytes.Length);
+            WavFile.WritePcm16(outputPath, samples, rate, 1);
+            return true;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or EndOfStreamException)
+        {
+            return false;
+        }
+    }
+}
diff --git a/src/HomePlayer.Core/LiveDubbingScheduler.cs b/src/HomePlayer.Core/LiveDubbingScheduler.cs
new file mode 100644
index 0000000..b1b8f9a
--- /dev/null
+++ b/src/HomePlayer.Core/LiveDubbingScheduler.cs
@@ -0,0 +1,202 @@
+namespace HomePlayer.Core;
+
+public enum LiveDubbingCueState
+{
+    Pending = 0,
+    Ready = 1,
+    Done = 2,
+    Skipped = 3
+}
+
+public sealed record LiveDubbingJob(long Key, double StartSeconds, double EndSeconds, string Text, int Speaker = -1);
+
+/// <summary>
+/// 实时配音逐句状态机：识别定稿先登记，译文和说话人都就绪后才排队合成，
+/// 覆盖率用于判断播放器需要缓冲到哪个时间点。
+/// </summary>
+public sealed class LiveDubbingScheduler
+{
+    private const double LateTolerance = 0.5;
+
+    private sealed class Entry(double start, double end)
+    {
+        public double Start { get; } = start;
+        public double End { get; } = end;
+        public string? Text { get; set; }
+        public bool TranslationReady { get; set; }
+        public bool SpeakerReady { get; set; }
+        public int Speaker { get; set; } = -1;
+        public LiveDubbingCueState State { get; set; } = LiveDubbingCueState.Pending;
+    }
+
+    private readonly object _gate = new();
+    private readonly Dictionary<long, Entry> _entries = [];
+    private readonly SortedSet<(double Start, long Key)> _order = [];
+    private double _recognizedThrough;
+
+    public void Reset(double position)
+    {
+        lock (_gate)
+        {
+            _entries.Clear();
+            _order.Clear();
+            _recognizedThrough = Math.Max(0, position);
+        }
+    }
+
+    public void Track(long key, double startSeconds, double endSeconds)
+    {
+        if (endSeconds <= startSeconds)
+            return;
+        lock (_gate)
+        {
+            if (_entries.ContainsKey(key))
+                return;
+            _entries[key] = new Entry(startSeconds, endSeconds);
+            _order.Add((startSeconds, key));
+        }
+    }
+
+    public void Translate(long key, string? text)
+    {
+        lock (_gate)
+        {
+            if (!_entries.TryGetValue(key, out var entry) || entry.State is LiveDubbingCueState.Done or LiveDubbingCueState.Skipped)
+                return;
+            if (string.IsNullOrWhiteSpace(text))
+            {
+                entry.Text = null;
+                entry.State = LiveDubbingCueState.Skipped;
+                return;
+            }
+
+            entry.Text = text.Trim();
+            entry.TranslationReady = true;
+            RefreshLocked(entry);
+        }
+    }
+
+    public void AssignSpeaker(long key, int speaker)
+    {
+        lock (_gate)
+        {
+            if (!_entries.TryGetValue(key, out var entry) || entry.State is LiveDubbingCueState.Done or LiveDubbingCueState.Skipped)
+                return;
+            entry.Speaker = speaker;
+            entry.SpeakerReady = true;
+            RefreshLocked(entry);
+        }
+    }
+
+    /// <summary>
+    /// 分离已经越过句子末尾仍没有匹配到说话人时，用默认音色继续，避免缓冲无限等待。
+    /// </summary>
+    public int ExpireSpeakers(double diarizedThrough, double graceSeconds)
+    {
+        lock (_gate)
+        {
+            var count = 0;
+            foreach (var (_, key) in _order)
+            {
+                var entry = _entries[key];
+                if (entry.State is LiveDubbingCueState.Done or LiveDubbingCueState.Skipped)
+                    continue;
+                if (entry.SpeakerReady || entry.End + graceSeconds > diarizedThrough)
+                    continue;
+                entry.Speaker = -1;
+                entry.SpeakerReady = true;
+                RefreshLocked(entry);
+                count++;
+            }
+
+            return count;
+        }
+    }
+
+    public void Skip(long key)
+    {
+        lock (_gate)
+        {
+            if (_entries.TryGetValue(key, out var entry) && entry.State is not (LiveDubbingCueState.Done or LiveDubbingCueState.Skipped))
+                entry.State = LiveDubbingCueState.Skipped;
+        }
+    }
+
+    public void Complete(long key)
+    {
+        lock (_gate)
+        {
+            if (_entries.TryGetValue(key, out var entry))
+                entry.State = LiveDubbingCueState.Done;
+        }
+    }
+
+    public void SetRecognizedThrough(double seconds)
+    {
+        lock (_gate)
+            _recognizedThrough = Math.Max(_recognizedThrough, seconds);
+    }
+
+    /// <summary>
+    /// 已完整处理到的时间点：识别前沿和最早未完成句子起点中的较小值。
+    /// </summary>
+    public double CoveredThrough
+    {
+        get
+        {
+            lock (_gate)
+            {
+                var boundary = double.PositiveInfinity;
+                foreach (var (start, key) in _order)
+                {
+                    var state = _entries[key].State;
+                    if (state is LiveDubbingCueState.Pending or LiveDubbingCueState.Ready)
+                    {
+                        boundary = start;
+                        break;
+                    }
+                }
+
+                return Math.Min(_recognizedThrough, boundary);
+            }
+        }
+    }
+
+    /// <summary>
+    /// 返回播放头附近最早一句待合成台词；太晚的句子直接标记完成，避免无限等待。
+    /// </summary>
+    public LiveDubbingJob? Next(double playheadSeconds, double lookaheadSeconds)
+    {
+        lock (_gate)
+        {
+            foreach (var (_, key) in _order)
+            {
+                var entry = _entries[key];
+                if (entry.State is LiveDubbingCueState.Done or LiveDubbingCueState.Skipped)
+                    continue;
+                if (entry.End <= playheadSeconds - LateTolerance)
+                    entry.State = LiveDubbingCueState.Done;
+            }
+
+            foreach (var (start, key) in _order)
+            {
+                var entry = _entries[key];
+                if (start > playheadSeconds + lookaheadSeconds)
+                    break;
+                if (entry.State != LiveDubbingCueState.Ready || entry.Text == null)
+                    continue;
+                if (entry.End <= playheadSeconds - LateTolerance)
+                    continue;
+                return new LiveDubbingJob(key, entry.Start, entry.End, entry.Text, entry.Speaker);
+            }
+
+            return null;
+        }
+    }
+
+    private static void RefreshLocked(Entry entry)
+    {
+        if (entry.TranslationReady && entry.SpeakerReady)
+            entry.State = LiveDubbingCueState.Ready;
+    }
+}
diff --git a/src/HomePlayer.Core/LiveDubbingTrack.cs b/src/HomePlayer.Core/LiveDubbingTrack.cs
new file mode 100644
index 0000000..5ec0b7d
--- /dev/null
+++ b/src/HomePlayer.Core/LiveDubbingTrack.cs
@@ -0,0 +1,145 @@
+namespace HomePlayer.Core;
+
+public sealed record LiveDubbingSegment(
+    long Key,
+    double StartSeconds,
+    double EndSeconds,
+    int SampleRate,
+    short[] Samples);
+
+public sealed record LiveDubbingSpeechSpan(double StartSeconds, double EndSeconds);
+
+/// <summary>
+/// 实时配音的动态段落表。写入方是后台合成任务，读取方是播放器的音频线程，
+/// 用写时复制保证混音时不需要长时间持锁。
+/// </summary>
+public sealed class LiveDubbingTrack
+{
+    private const double MergeGapSeconds = 0.15;
+
+    private readonly object _gate = new();
+    private LiveDubbingSegment[] _segments = [];
+    private LiveDubbingSpeechSpan[] _speech = [];
+    private long _epoch;
+
+    public long Epoch => Volatile.Read(ref _epoch);
+
+    public LiveDubbingSegment[] Snapshot() => Volatile.Read(ref _segments);
+
+    /// <summary>
+    /// 已识别到的人声区间。混音按这里压低原声，而不是只看已经合成好的配音片段，
+    /// 否则识别到但还没合成（或合成失败）的句子会漏出原音。
+    /// </summary>
+    public LiveDubbingSpeechSpan[] SpeechSnapshot() => Volatile.Read(ref _speech);
+
+    public void Reset(double position)
+    {
+        lock (_gate)
+        {
+            _segments = [];
+            _speech = [];
+            Interlocked.Increment(ref _epoch);
+        }
+    }
+
+    public void AddSpeech(double startSeconds, double endSeconds)
+    {
+        if (endSeconds <= startSeconds)
+            return;
+
+        lock (_gate)
+        {
+            var merged = new List<LiveDubbingSpeechSpan>(_speech.Length + 1);
+            var start = startSeconds;
+            var end = endSeconds;
+            var inserted = false;
+            foreach (var span in _speech)
+            {
+                if (span.EndSeconds < start - MergeGapSeconds)
+                {
+                    merged.Add(span);
+                    continue;
+                }
+
+                if (span.StartSeconds > end + MergeGapSeconds)
+                {
+                    if (!inserted)
+                    {
+                        merged.Add(new LiveDubbingSpeechSpan(start, end));
+                        inserted = true;
+                    }
+
+                    merged.Add(span);
+                    continue;
+                }
+
+                start = Math.Min(start, span.StartSeconds);
+                end = Math.Max(end, span.EndSeconds);
+            }
+
+            if (!inserted)
+                merged.Add(new LiveDubbingSpeechSpan(start, end));
+            _speech = [.. merged];
+        }
+    }
+
+    /// <summary>
+    /// 某句最终没有配音（翻译失败或被跳过）时撤掉它的压低区间，宁可放回原声也不要整段静音。
+    /// </summary>
+    public void RemoveSpeech(double startSeconds, double endSeconds)
+    {
+        if (endSeconds <= startSeconds)
+            return;
+
+        lock (_gate)
+        {
+            var next = new List<LiveDubbingSpeechSpan>(_speech.Length + 1);
+            foreach (var span in _speech)
+            {
+                if (span.EndSeconds <= startSeconds || span.StartSeconds >= endSeconds)
+                {
+                    next.Add(span);
+                    continue;
+                }
+
+                if (startSeconds - span.StartSeconds > 0.05)
+                    next.Add(span with { EndSeconds = startSeconds });
+                if (span.EndSeconds - endSeconds > 0.05)
+                    next.Add(span with { StartSeconds = endSeconds });
+            }
+
+            _speech = [.. next];
+        }
+    }
+
+    public void Add(LiveDubbingSegment segment)
+    {
+        if (segment.Samples.Length == 0 || segment.EndSeconds <= segment.StartSeconds || segment.SampleRate <= 0)
+            return;
+
+        lock (_gate)
+        {
+            var next = new List<LiveDubbingSegment>(_segments.Length + 1);
+            foreach (var existing in _segments)
+            {
+                if (existing.Key != segment.Key)
+                    next.Add(existing);
+            }
+
+            next.Add(segment);
+            next.Sort((left, right) => left.StartSeconds.CompareTo(right.StartSeconds));
+            _segments = [.. next];
+        }
+    }
+
+    public void EvictBefore(double seconds)
+    {
+        lock (_gate)
+        {
+            if (_segments.Length > 0 && _segments[0].EndSeconds < seconds)
+                _segments = _segments.Where(segment => segment.EndSeconds >= seconds).ToArray();
+            if (_speech.Length > 0 && _speech[0].EndSeconds < seconds)
+                _speech = _speech.Where(span => span.EndSeconds >= seconds).ToArray();
+        }
+    }
+}
diff --git a/src/HomePlayer.Core/LiveSpeakerTimeline.cs b/src/HomePlayer.Core/LiveSpeakerTimeline.cs
new file mode 100644
index 0000000..491a270
--- /dev/null
+++ b/src/HomePlayer.Core/LiveSpeakerTimeline.cs
@@ -0,0 +1,105 @@
+namespace HomePlayer.Core;
+
+public sealed record LiveSpeakerSegment(int Speaker, double StartSeconds, double EndSeconds);
+
+/// <summary>
+/// 流式说话人时间线：记录已分析的说话人段和分离前沿，供实时配音分配角色。
+/// </summary>
+public sealed class LiveSpeakerTimeline
+{
+    private const double MergeGapSeconds = 0.35;
+    private const double MinimumOverlapSeconds = 0.1;
+
+    private readonly object _gate = new();
+    private readonly List<LiveSpeakerSegment> _segments = [];
+    private double _through;
+
+    public double DiarizedThrough
+    {
+        get
+        {
+            lock (_gate)
+                return _through;
+        }
+    }
+
+    public IReadOnlyList<LiveSpeakerSegment> Snapshot()
+    {
+        lock (_gate)
+            return _segments.ToArray();
+    }
+
+    public void SetThrough(double seconds)
+    {
+        lock (_gate)
+            _through = Math.Max(_through, seconds);
+    }
+
+    public void Add(LiveSpeakerSegment segment)
+    {
+        if (segment.Speaker < 0 || segment.EndSeconds <= segment.StartSeconds)
+            return;
+        lock (_gate)
+        {
+            _segments.Add(segment);
+            _segments.Sort((left, right) => left.StartSeconds.CompareTo(right.StartSeconds));
+            MergeLocked();
+            _through = Math.Max(_through, segment.EndSeconds);
+        }
+    }
+
+    public int DominantSpeaker(double startSeconds, double endSeconds)
+    {
+        if (endSeconds <= startSeconds)
+            return -1;
+        lock (_gate)
+        {
+            var best = -1;
+            var bestOverlap = MinimumOverlapSeconds;
+            foreach (var segment in _segments)
+            {
+                if (segment.StartSeconds >= endSeconds)
+                    break;
+                var overlap = Math.Min(endSeconds, segment.EndSeconds) - Math.Max(startSeconds, segment.StartSeconds);
+                if (overlap > bestOverlap)
+                {
+                    bestOverlap = overlap;
+                    best = segment.Speaker;
+                }
+            }
+
+            return best;
+        }
+    }
+
+    public void Reset()
+    {
+        lock (_gate)
+        {
+            _segments.Clear();
+            _through = 0;
+        }
+    }
+
+    private void MergeLocked()
+    {
+        var merged = new List<LiveSpeakerSegment>(_segments.Count);
+        foreach (var segment in _segments)
+        {
+            if (merged.Count > 0)
+            {
+                var last = merged[^1];
+                if (last.Speaker == segment.Speaker && segment.StartSeconds <= last.EndSeconds + MergeGapSeconds)
+                {
+                    merged[^1] = last with { EndSeconds = Math.Max(last.EndSeconds, segment.EndSeconds) };
+                    continue;
+                }
+            }
+
+            merged.Add(segment);
+        }
+
+        _segments.Clear();
+        _segments.AddRange(merged);
+    }
+}
